-- Custom repository for cardano haskell packages, see CONTRIBUTING for more
repository cardano-haskell-packages
  url: https://chap.intersectmbo.org/
  secure: True
  root-keys:
    3e0cce471cf09815f930210f7827266fd09045445d65923e6d0238a6cd15126f
    443abb7fb497a134c343faf52f0b659bd7999bc06b7f63fa76dc99d631f9bea1
    a86a1f6ce86c449c46666bda44268677abf29b5b2d2eb5ec7af903ec2f117a82
    bcec67e8e99cabfa7764d75ad9b158d72bfacf70ca1d0ec8bc6b4406d1bf8413
    c00aae8461a256275598500ea0e187588c35a5d5d7454fb57eac18d9edb86a56
    d4a35cd3121aa00d18544bb0ac01c3e1691d618f462c46129271bccf39f7e8ee

-- See CONTRIBUTING for information about these, including some Nix commands
-- you need to run if you change them
index-state:
  , hackage.haskell.org 2026-09-20T20:47:43Z
  , cardano-haskell-packages 2026-09-16T23:53:07Z


constraints:
  -- haskell.nix patch does not work for 1.6.8
  -- grapesy currently depends on crypton-x509-system (>=1.6 && <1.7)
  , any.crypton-x509-system < 1.6.8 || >= 1.7

  -- EXPERIMENT: force cardano-crypto-class up to the 2.6.x line (which
  -- requires crypton ^>=1.1) to see how far the crypton >= 1.1 / memory ->
  -- ram migration gets. Several local packages pin cardano-crypto-class
  -- ^>=2.5, so their bound needs an allow-newer below too.
  , any.cardano-crypto-class ^>=2.6

  -- EXPERIMENT: cardano-crypto-1.2.0 (the version the solver reaches for
  -- otherwise) still uses the old `memory` package for ByteArrayAccess,
  -- which doesn't unify with crypton-1.1.4's `ram`-based Digest instances.
  -- cardano-crypto-1.4.0 (already in CHaP) has switched to ram >=0.22.
  , any.cardano-crypto >= 1.4

  -- haskell.nix tries to use 0.7.1.5 for some reason
  , any.proto-lens >= 0.7.1.7
  -- https://github.com/channable/alfred-margaret/pull/76
  , any.alfred-margaret < 2.1.1.0 || > 2.1.1.0

-- acts has a finitary flag; disabling it avoids pulling in finitary entirely,
-- which sidesteps the GHC type-checker plugin incompatibility with
-- cross-compilation to Windows (finitary-2.2.0.0+)
package acts
  flags: -finitary

packages:
  cardano-node
  cardano-node-capi
  cardano-node-chairman
  cardano-submit-api
  cardano-testnet
  cardano-tracer
  bench/cardano-profile
  bench/cardano-topology
  bench/locli
  bench/plutus-scripts-bench
  bench/tx-generator
  bench/cardano-timeseries-io
  bench/trace-schemas/scripts/schema-gen
  trace-forward

-- Shipped as a release binary but not a dependency of any local package, so it
-- has to be added to the install plan explicitly.
extra-packages: dmq-node >= 0.7.0.0

program-options
  ghc-options: -Werror

test-show-details: direct

-- Always write GHC env files, because they are needed for ghci.
write-ghc-environment-files: always

package cryptonite
  -- Using RDRAND instead of /dev/urandom as an entropy source for key
  -- generation is dubious. Set the flag so we use /dev/urandom by default.
  flags: -support_rdrand

package snap-server
  flags: -openssl

package bitvec
  flags: -simd

package cardano-diffusion
  flags: +optparse-applicative-fork

-- required for haddocks to build successfully
package plutus-scripts-bench
  haddock-options: "--optghc=-fplugin-opt=PlutusTx.Plugin:defer-errors"

-- There is a suspected bug in `cabal` (https://github.com/haskell/cabal/issues/11663)
-- that can be worked around with the following allow-newer stanzas
allow-newer:
  , io-sim:time
  , io-classes:time

  -- EXPERIMENT: these packages pin cardano-crypto-class to <2.6 (either
  -- ^>=2.5 or an explicit >=x.y && <2.6); let them accept the 2.6.x line so
  -- crypton can move to >= 1.1. (cardano-api's own bound is already ^>=2.6
  -- on the erikd/crypton+ram SRP, cardano-node/-chairman/
  -- cardano-submit-api/cardano-testnet's own bounds were widened to
  -- ^>=2.5||^>=2.6 directly, and ouroboros-consensus main and the whole
  -- cardano-ledger monorepo SRP below already accept up to <2.7 natively,
  -- so none of those need an entry here.)
  , cardano-cli:cardano-crypto-class
  , cardano-keys:cardano-crypto-class
  , kes-agent:cardano-crypto-class
  , kes-agent-crypto:cardano-crypto-class

  -- EXPERIMENT: cardano-cli (CHaP, unmodified) pins cardano-crypto-wrapper
  -- ^>=1.7; let it accept the erikd/ram-based 1.8.0.0 SRP above.
  -- (cardano-api's own bound is already ^>=1.7||^>=1.8, no entry needed.)
  , cardano-cli:cardano-crypto-wrapper

  -- EXPERIMENT: cardano-api PR #1292 now depends on the new cardano-keys
  -- package (CHaP 11.0.0.0, extracted from cardano-api's own key-handling
  -- modules -- Ed25519Bip32.hs/Mnemonic.hs/Sign.hs, the actual crypton/ram
  -- fix targets, stayed in cardano-api; cardano-keys took the rest, e.g.
  -- Leios.hs, which is now just a re-export). cardano-keys itself still pins
  -- cardano-crypto-class ^>=2.5 and cardano-crypto-wrapper ^>=1.7 natively
  -- (no memory dependency though, so not a blocker otherwise); let it accept
  -- the widened versions.
  , cardano-keys:cardano-crypto-wrapper

  -- TEMPORARY: cardano-keys (CHaP 11.0.0.0, unmodified) pins
  -- cardano-ledger-core ^>=1.21 and cardano-ledger-shelley ^>=1.19, both
  -- excluding the versions the cardano-ledger monorepo SRP below now
  -- provides (1.22.0.0 / 1.20.0.0); let it accept them.
  , cardano-keys:cardano-ledger-core
  , cardano-keys:cardano-ledger-shelley

-- TEMPORARY: ouroboros-consensus's main branch (below) doesn't keep its own
-- version field in sync with real numbered releases -- those are cut from
-- separate release branches -- so main's version field is a permanently
-- stale placeholder (confirmed: still 4.0.0.0 even though main's actual
-- code is well past the real 4.2.1.0 release). Since main is the shared
-- upstream integration branch, not something we can push a version-bump
-- commit to, bridge with allow-older instead of chasing a bump-and-push
-- fix each time.
allow-older:
  , cardano-node:ouroboros-consensus
  , tx-generator:ouroboros-consensus
  , cardano-api:ouroboros-consensus
  , dmq-node:ouroboros-consensus

-- cabal-allow-newer begin
if impl(ghc >= 9.14)
  allow-newer:
    , async-timer:unliftio-core
    , attoparsec-iso8601:time
    , bytestring-trie:base
    , canonical-json:containers
    , cborg:base
    , cborg:containers
    , cborg-json:aeson
    , cborg-json:base
    , compact:base
    , crypton-connection:tls
    , dependent-map:containers
    , diff-containers:base
    , dictionary-sharing:containers
    , dmq-node:containers
    , dmq-node:time
    , ekg-json:aeson
    , ekg-json:text
    , ekg-prometheus-adapter:containers
    , ekg-wai:time
    , errors:transformers-compat
    , fs-sim:QuickCheck
    , grapesy:aeson
    , grapesy:base
    , grapesy:containers
    , grapesy:time-manager
    , grapesy:tls
    , grpc-spec:aeson
    , grpc-spec:base
    , grpc-spec:containers
    , iohk-monitoring:contra-tracer
    , lens-family:containers
    , lens-family-core:containers
    , locli:ouroboros-network
    , microstache:aeson
    , monad-control:transformers-compat
    , nothunks:containers
    , nothunks:time
    , optparse-generic:time
    , partial-order:containers
    , pipes-safe:containers
    , pipes-safe:mtl
    , pipes-safe:primitive
    , pipes-safe:transformers
    , prometheus:containers
    , safe-wild-cards:template-haskell
    , serdoc-core:template-haskell
    , serialise:base
    , serialise:containers
    , serialise:time
    , servant:QuickCheck
    , servant:base
    , servant-server:aeson
    , servant-server:attoparsec
    , servant-server:base
    , servant-server:base-compat
    , servant-server:base64-bytestring
    , servant-server:bytestring
    , servant-server:containers
    , servant-server:http-api-data
    , servant-server:http-types
    , servant-server:network
    , servant-server:servant
    , servant-server:text
    , servant-server:transformers
    , servant-server:warp
    , strict-checked-vars:io-classes
    , strict-stm:base
    , strict-stm:io-classes
    , tdigest:base
    , time-locale-compat:time
    , tracer-transformers:contra-tracer
    , vary:aeson
    , with-utf8:base
-- cabal-allow-newer end

-- IMPORTANT
-- Do NOT add more source-repository-package stanzas here unless they are strictly
-- temporary! Please read the section in CONTRIBUTING about updating dependencies.

-- cardano-ledger PR #5999 (erikd/ram): MERGED into master.
-- https://github.com/IntersectMBO/cardano-ledger/pull/5999
-- cardano-crypto-wrapper bumped to 1.8.0.0, crypton >=1.1 (no upper bound),
-- and build-depends swapped from memory to ram (module names are identical
-- between the two packages, so no source-import changes were needed).
--
-- TEMPORARY: pulling in the whole monorepo here, not just
-- eras/byron/crypto, because ouroboros-consensus main (below) transitively
-- needs cardano-ledger-binary ^>=1.10, small-steps ^>=1.2 and
-- cardano-ledger-core ^>=1.22 -- none released to CHaP yet (latest there:
-- cardano-ledger-binary-1.9.0.0, small-steps-1.1.4.0,
-- cardano-ledger-core-1.21.0.0) -- and every other era package in the
-- monorepo has to move in lockstep with whichever of these it depends on,
-- or the solver ends up trying to mix this commit's cardano-ledger-core
-- with CHaP's older era packages that were built against it. Drop the
-- extra subdirs (keep only eras/byron/crypto) once cardano-ledger-binary/
-- small-steps/cardano-ledger-core catch up on CHaP.
source-repository-package
  type: git
  location: https://github.com/IntersectMBO/cardano-ledger.git
  tag: 116dab4b22e3ee21b31f6d5e7814306d660c76ac
  subdir:
    eras/allegra/impl
    eras/alonzo/impl
    eras/babbage/impl
    eras/byron/chain/executable-spec
    eras/byron/crypto
    eras/byron/ledger/executable-spec
    eras/byron/ledger/impl
    eras/conway/impl
    eras/dijkstra/impl
    eras/mary/impl
    eras/shelley/impl
    eras/shelley/test-suite
    libs/cardano-data
    libs/cardano-ledger-api
    libs/cardano-ledger-binary
    libs/cardano-ledger-core
    libs/cardano-protocol
    libs/cardano-protocol-tpraos
    libs/non-integral
    libs/small-steps
    libs/vector-map

-- cardano-base (pre-DST-internalisation cardano-crypto-leios): ouroboros-
-- consensus main (above) needs cardano-crypto-leios ^>=0.3, which doesn't
-- exist in CHaP at all (it's not part of the cardano-ledger monorepo
-- either).
--
-- Tried sourcing cardano-crypto-class from cardano-base's tip too (not just
-- cardano-crypto-leios), reasoning that cardano-crypto-leios's
-- verifyPossessionProofDSIGN/verifyDSIGN calls only typecheck against
-- cardano-base's OWN (newer) cardano-crypto-class: CHaP's published
-- cardano-crypto-class-2.6.0.0 tarball predates the "drop leiosSignContext,
-- DST is internal to the scheme" refactor (58f5a53a / 3d5e2ba1) and still
-- has `type ContextDSIGN (BLS12381DSIGN curve) = BLS12381SignContext` plus
-- a 3-argument verifyPossessionProofDSIGN, whereas cardano-base's real tip
-- has moved to `= ()` and a 2-argument verifyPossessionProofDSIGN (same
-- version number -- doesn't track real changes, as with several other
-- repos in this migration). That fixed cardano-crypto-leios but broke both
-- ouroboros-consensus main's own Committee/Crypto/BLS.hs (imports
-- BLS12381SignContext/minSigPoPDST/blsSignContextAug, all removed by the
-- refactor) and cardano-ledger-core's testlib (same). Those are two big,
-- central packages that would need real upstream fixes to move to the new
-- API, versus cardano-crypto-leios which is small and peripheral -- so
-- instead we pin cardano-crypto-leios itself to 3d5e2ba1 (the last commit
-- before the refactor: it only touches cardano-crypto-class, leaving
-- Leios.hs still using the old explicit `leiosSignContext`/`minSigPoPDST`
-- calls), and go back to resolving cardano-crypto-class from CHaP as usual.
-- No code fix needed either way -- just picking the commit whose
-- cardano-crypto-leios source matches CHaP's actual API.
-- TEMPORARY -- drop this whole stanza once cardano-crypto-leios-0.3.0.0+ is
-- released to CHaP.
source-repository-package
  type: git
  location: https://github.com/intersectmbo/cardano-base.git
  tag: 3d5e2ba1e76b7cd3bead8bd3f81a2e7ee743ce5c
  subdir: cardano-crypto-leios

-- ouroboros-consensus main: switched from PR #2213 (erikd/ram) now that
-- main itself builds natively against crypton 1.1.4 / cardano-crypto-class
-- ^>=2.6 (confirmed: no `memory` dependency, cardano-crypto-class ^>=2.6 at
-- line ~374 of ouroboros-consensus.cabal). main's own version field is a
-- permanently stale placeholder (still 4.0.0.0; real releases are cut from
-- separate release branches and never merged back to bump main's version),
-- so cardano-node's ^>=4.2.0.1 and cardano-api's ^>=4.2.1.0 bounds are
-- bridged with allow-older above rather than a version-bump commit (main
-- is upstream's shared integration branch, not something to push a bump to
-- directly). main also transitively needs cardano-ledger-binary ^>=1.10
-- and cardano-crypto-leios ^>=0.3, neither released to CHaP -- see the two
-- extra source-repository-package stanzas above and the matching
-- allow-newer entries for their CHaP-released dependents. The .cabal lives
-- at the repo root (its own cabal.project says `packages: .`), so no
-- subdir is needed.
source-repository-package
  type: git
  location: https://github.com/IntersectMBO/ouroboros-consensus.git
  tag: 32838381afa79a0df04f2604e36cfa7ba00d5863

-- cardano-api PR #1292 (erikd/crypton+ram):
-- https://github.com/IntersectMBO/cardano-api/pull/1292
-- rebased onto current cardano-api master (11.7.0.0), picking up the TCP/TLS
-- RPC listening feature cardano-node master now uses, the
-- ouroboros-consensus ^>=4.2.1.0 bound bump, and the
-- caseShelleyToBabbageOrConwayEraOnwards removal (cardano-cli PR #1417
-- still calls this in 5 places -- needs a matching update, see PR #1417's
-- SRP comment below). Also widens its own resource-registry (^>=0.3||^>=0.4),
-- small-steps (^>=1.1||^>=1.2), cardano-ledger-api (^>=1.14||^>=1.15) and
-- plutus-core/plutus-ledger-api (^>=1.65||^>=1.68) bounds directly, needed
-- now that ouroboros-consensus main (below) pulls in newer versions of
-- those transitively. cardano-crypto-class ^>=2.6 and cardano-crypto-wrapper
-- ^>=1.7||^>=1.8 still accepted natively, and no `memory` dependency
-- anywhere.
source-repository-package
  type: git
  location: https://github.com/IntersectMBO/cardano-api.git
  tag: 490642565221d7d9ad8c38f0c4f7bb9a7e23017d
  subdir: cardano-api

-- cardano-api PR #1292 (erikd/crypton+ram):
-- https://github.com/IntersectMBO/cardano-api/pull/1292
-- cardano-rpc lives in the same repo/commit as the cardano-api SRP above
-- and needs to move in lockstep with it -- now at 11.4.0.0, includes the
-- TCP/TLS RPC listening feature, no `memory` dependency. One extra commit
-- on top of the master rebase: cardano-api's own new
-- serverExceptionToClient assignment in Cardano.Rpc.Server was written
-- against an older grapesy (SomeException-typed field); grapesy-1.2.0
-- (what we resolve) changed this field to ExactException. Fixed by
-- unwrapping via the ExactException pattern before use -- unrelated to
-- crypton/ram, just a side effect of rebasing onto real cardano-api master
-- with a newer Hackage index-state than upstream's own CI uses.
source-repository-package
  type: git
  location: https://github.com/IntersectMBO/cardano-api.git
  tag: 490642565221d7d9ad8c38f0c4f7bb9a7e23017d
  subdir: cardano-rpc

-- cardano-cli PR #1417 (erikd/crypton-ram):
-- https://github.com/IntersectMBO/cardano-cli/pull/1417
-- rebased onto current cardano-cli master (11.2.3.1), which now requires
-- cardano-api ^>=11.7 (matching the cardano-api PR #1292 SRP above) and no
-- longer calls the removed caseShelleyToBabbageOrConwayEraOnwards (replaced
-- upstream with inEonForShelleyBasedEra; our own getStakeCred helper in
-- Transaction/Run.hs was renamed to attachWitness by the same upstream
-- commit, logic unchanged). Still pins cardano-crypto-class ^>=2.5 and
-- cardano-crypto-wrapper ^>=1.7 natively (unchanged), so the existing
-- allow-newer entries for those still apply. One extra commit on top: the
-- cardano-api PR #1292 rebase changed cardano-protocol-tpraos's KESPeriod
-- to derive no Integral instance; EraBased.Query.Run's
-- opCertStartingKesPeriod called fromIntegral directly on it -- fixed by
-- unwrapping via unKESPeriod first.
source-repository-package
  type: git
  location: https://github.com/IntersectMBO/cardano-cli.git
  tag: 39d02bb14b6768aed7fd5173aeaab90ac8ebe2f9
  subdir: cardano-cli
