  location: https://github.com/IntersectMBO/cardano-cli
  tag: 64aca1c00a65fd501e2229547045587cf686a8ce
  --sha256: sha256-eyckGs9i6mRB+noz3yBEovwC0gAVI6hyOeV1NeiawDU=
