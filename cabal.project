-- Custom repository for cardano haskell packages, see CONTRIBUTING for more
repository cardano-haskell-packages
  url: https://chap.intersectmbo.org/
  secure: True
  root-keys:
    3e0cce471cf09815f930210f7827266fd09045445d65923e6d0238a6cd15126f
    443abb7fb497a134c343faf52f0b659bd7999bc06b7f63fa76dc99d631f9bea1
    a86a1f6ce86c449c46666bda44268677abf29b5b2d2eb5ec7af903ec2f117a82
    bcec67e8e99cabfa7764d75ad9b158d72bfacf70ca1d0ec8bc6b4406d1bf8413
    c00aae8461a256275598500ea0e187588c35a5d5d7454fb57eac18d9edb86a56
    d4a35cd3121aa00d18544bb0ac01c3e1691d618f462c46129271bccf39f7e8ee

-- See CONTRIBUTING for information about these, including some Nix commands
-- you need to run if you change them
index-state:
  , hackage.haskell.org 2026-09-29T11:48:37Z
  , cardano-haskell-packages 2026-10-21T10:21:18Z

constraints:
  -- haskell.nix patch does not work for 1.6.8
  , any.crypton-x509-system < 1.6.8 || >= 1.7
  -- haskell.nix tries to use 0.7.1.5 for some reason
  , any.proto-lens >= 0.7.1.7
  -- https://github.com/channable/alfred-margaret/pull/76
  , any.alfred-margaret < 2.1.1.0 || > 2.1.1.0
  , any.grapesy >= 1.2.1

-- acts has a finitary flag; disabling it avoids pulling in finitary entirely,
-- which sidesteps the GHC type-checker plugin incompatibility with
-- cross-compilation to Windows (finitary-2.2.0.0+)
package acts
  flags: -finitary

packages:
  cardano-node
  cardano-node-capi
  cardano-node-chairman
  cardano-submit-api
  cardano-testnet
  cardano-tracer
  bench/cardano-profile
  bench/cardano-topology
  bench/locli
  bench/plutus-scripts-bench
  bench/tx-generator
  bench/cardano-timeseries-io
  bench/trace-schemas/scripts/schema-gen
  trace-forward

-- Needed when cross compiling
extra-packages: dmq-node

program-options
  ghc-options: -Werror

test-show-details: direct

-- Always write GHC env files, because they are needed for ghci.
write-ghc-environment-files: always

package cryptonite
  -- Using RDRAND instead of /dev/urandom as an entropy source for key
  -- generation is dubious. Set the flag so we use /dev/urandom by default.
  flags: -support_rdrand

package bitvec
  flags: -simd

-- required for haddocks to build successfully
package plutus-scripts-bench
  haddock-options: "--optghc=-fplugin-opt=PlutusTx.Plugin:defer-errors"

if impl(ghc >= 9.14)
  -- some-1.1 adds EqP/OrdP superclasses to GEq/GCompare, which plutus-core
  -- 1.71.0.0 is not written against:
  --
  --   Universe/Core.hs:755:10: error: [GHC-39999]
  --     Could not deduce 'Data.EqP.EqP (ValueOf uni)'
  --       arising from the superclasses of an instance declaration
  --
  -- some-1.0.6 is what every other compiler resolves to and it already allows
  -- base < 4.23, so it is usable on 9.14; the solver simply prefers the newest.
  -- Pin it rather than relaxing dependent-sum's some >= 1.0.4 && < 1.0.7 bound.
  constraints:
    , any.some < 1.1

  -- GHC 9.14.1 ships base-4.22, template-haskell-2.24, containers-0.8,
  -- time-1.15 and ghc-9.14.1. Every entry below is a dependency whose upper
  -- bound predates one of those and has no release on Hackage/CHaP that admits
  -- it, so the solver has no plan without the relaxation.
  allow-newer:
    -- base < 4.22
    , bytestring-trie:base
    , cborg:base
    , cborg-json:base
    , compact:base
    , ekg-json:base
    , http-api-data:base
    , serialise:base
    , servant-server:base
    , tdigest:base
    , with-utf8:base
    -- template-haskell < 2.24
    , safe-wild-cards:template-haskell
    , serdoc-core:template-haskell
    -- containers < 0.8
    , canonical-json:containers
    , cborg:containers
    , dependent-map:containers
    , dictionary-sharing:containers
    , ekg-prometheus-adapter:containers
    , lens-family:containers
    , lens-family-core:containers
    , prometheus:containers
    , serialise:containers
    -- time < 1.15
    , ekg-wai:time
    , serialise:time
    -- io-classes: io-sim requires ^>=1.11 while cardano-node and
    -- ouroboros-network cap at ^>=1.8 || ^>=1.9. On 9.14 every older io-sim is
    -- excluded by base < 4.22, so the solver is forced to io-classes 1.11 and
    -- all of these bounds have to give way together.
    , blockio:io-classes
    , cardano-diffusion:io-classes
    , cardano-node:io-classes
    , cardano-node-chairman:io-classes
    , fs-api:io-classes
    , fs-sim:io-classes
    , kes-agent:io-classes
    , lsm-tree:io-classes
    , network-mux:io-classes
    , ouroboros-consensus:io-classes
    , ouroboros-network:io-classes
    -- Other
    , cborg-json:aeson
    , kes-agent:aeson
    , vary:aeson
    , errors:transformers-compat
    , monad-control:transformers-compat
    , servant-server:http-api-data

-- IMPORTANT
-- Do NOT add more source-repository-package stanzas here unless they are strictly
-- temporary! Please read the section in CONTRIBUTING about updating dependencies.

-- For networks with the Leios prototype (branches leios-main-compat).

-- master past PR #695: proofs of possession use the IETF BLS_POP_ DST and the BLS
-- DSTs take no signing context, as in the Leios prototype nodes.
source-repository-package
  type: git
  location: https://github.com/IntersectMBO/cardano-base
  tag: c1e1ed8d7ae39c111c73fc5f59ac37ce5933b83c
  --sha256: sha256-UawlVBgCkU8H6o1k8BHj6pRkZjbHsdVEVIBW0ZFpWkc=
  subdir:
    cardano-base
    cardano-binary
    cardano-crypto-class
    cardano-crypto-leios
    cardano-crypto-praos
    cardano-slotting
    cardano-strict-containers

source-repository-package
  type: git
  location: https://github.com/IntersectMBO/cardano-keys
  tag: a549816eca553796229df017980ea945cfda3d29
  --sha256: sha256-UFi8gv6+WtpjeAUaY+dkOiAWUeQTjT9XqpFhQjq9FFA=
  subdir:
    cardano-keys

