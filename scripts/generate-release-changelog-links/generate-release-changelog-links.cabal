cabal-version: 3.8
name:          generate-release-changelog-links
version:       0.1.0.0
synopsis:      Generate a changelog table for a cardano-node release
category:      Development
description:
  Reads a cabal plan.json (from plan-nix) and produces a Markdown table of
  CHANGELOG.md links for every CHaP-hosted package in the build plan.
license:       Apache-2.0
author:        IOHK
maintainer:    operations@iohk.io

common shared
  default-language: Haskell2010
  ghc-options:      -Wall -Wextra -Wcompat -flate-specialise
  default-extensions:
    BlockArguments
    DataKinds
    ImportQualifiedPost
    LambdaCase
    OverloadedStrings
    RecordWildCards
    ScopedTypeVariables
  build-depends:
    , base                 < 4.23
    , aeson                < 2.3
    , bytestring           < 0.13
    , cabal-plan           < 0.8
    , case-insensitive     < 1.3
    , containers           < 0.9
    , github               ^>= 0.30
    , http-client          < 0.8
    , http-types           < 0.13
    , network-uri          < 2.7
    , optparse-applicative < 0.20
    , req                  < 3.14
    , text                 < 2.2
    , uri-encode           < 1.6

executable generate-release-changelog-links
  import:           shared
  main-is:          Main.hs
  hs-source-dirs:   .
  ghc-options:      -threaded -rtsopts "-with-rtsopts=-A64m -I0"

test-suite release-changelog-tests
  import:           shared
  type:             exitcode-stdio-1.0
  main-is:          Tests.hs
  hs-source-dirs:   test .
  other-modules:    Main
  ghc-options:      -main-is Tests
