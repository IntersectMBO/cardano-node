        "peer": {
          "$ref": "types.schema.json#/$defs/Peer"
        }
      },
      "oneOf": [
        {
          "required": [
            "addBlock"
          ],
          "not": {
            "required": [
              "rollBackTo"
            ]
          }
        },
        {
          "required": [
            "rollBackTo"
          ],
          "not": {
            "required": [
