{% if scalingCSV %}
// Plutus workload calibration, as projected by the generator (one column per run).
// Rendered only if every run has the generator's budget summary.
{% let runCount = runs | length %}
= Addendum: Plutus Workload Calibration
#pad(top: 2em)[]

#let scalings = csv("{{scalingCSV}}")

#align(center)[
#table(
  columns: {{ runCount + 1 }},

  [], {% for run in runs %}[`{{run.value.meta.ident}}`],{% endfor %}
  ..scalings.flatten(),
)
]

#pagebreak()
{% endlet %}
{% endif %}
