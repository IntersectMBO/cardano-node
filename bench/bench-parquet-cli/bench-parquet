#!/usr/bin/env bash
# bench-parquet: process logs <-> Parquet, and querying them.
# Prototype (bash + SQL). See README.md.
set -euo pipefail

self_dir=$(dirname "$(realpath "${BASH_SOURCE[0]}")")
sql_dir=$self_dir/sql
DUCKDB=${DUCKDB:-duckdb}

converter_version=0.2
raw_schema_version=1
zstd_default=15
# Rows per row group. Smaller than DuckDB's default (122,880) so that reading the payload
# of a small namespace decompresses less of its neighbours: on the Leios run, 32,768 made
# block_ranking 3x faster for +1.8 % size (DUCKDB.md, "Backend comparison").
row_group_size=32768

usage() {
    cat <<EOF
Usage: bench-parquet COMMAND ARGS..

PQDIR is a directory written by convert: one <process>.parquet per log, plus
meta/files.parquet and meta/run.parquet. Every command except convert needs only it.

  convert PQDIR --run-id ID [--system-start TIMESTAMP --slot-length SECS]
          [--force] [--jobs N] [--keep-temp] [--zstd-level N] PROCESS=FILE..
        Convert each log FILE into PQDIR/PROCESS.parquet, losslessly, plus
        meta/files.parquet and meta/run.parquet. A process named node-* is a
        node, generator the generator (query sessions tell them apart by name).
          --run-id ID     the run's identifier, recorded in meta/run.parquet
          --system-start TIMESTAMP, --slot-length SECS
                          genesis system start (UTC) and slot length; without
                          them, slot arithmetic in query sessions is an error
          --force         replace an existing PQDIR (only once the new one is complete)
          --jobs N        slots (default: from available memory and cores); a log larger
                          than total size / slots gets its share of the slots
          --keep-temp     keep the temporary directory when a conversion fails
          --zstd-level N  zstd compression level (default: $zstd_default)

  restore PQDIR PROCESS -o FILE [--verify]
        Reconstruct a process's log. --verify checks the sha256 recorded at
        conversion. Refuses to write over the converted log itself.

  head PQDIR PROCESS [-n N]
  tail PQDIR PROCESS [-n N]
        The first / last N lines (default 20) of the process's log on stdout,
        byte for byte as in the original, text lines included.

  excerpt PQDIR (--at TIMESTAMP | --ns NAMESPACE [--where SQL]) [--before SECS] [--after SECS]
          [--process P].. -o OUTDIR
        Original log lines in a time window around a timestamp, or around the
        first event of NAMESPACE (optionally matching the SQL condition on its
        columns, e.g. "data->>'\$.slot' = '991'"), one file per process in OUTDIR.
        Defaults: --before 5 --after 5, all processes.

  lines PQDIR PROCESS [--ns-file FILE]
        The process's JSON lines on stdout, byte for byte as in the original log
        and in its order; with --ns-file only those of the namespaces listed in
        FILE (one per line). For locli prepare-db-from-lines.

  host-summary PQDIR PROCESS
        JSON on stdout: line counts per namespace ("tracefreqs"), the number of
        JSON lines ("lines"), and the timestamps of the first and the last JSON
        line in log order ("firstAt", "lastAt"). For locli prepare-db-from-lines.

  query PQDIR [--ui] [DUCKDB-ARGS..]
        Interactive DuckDB session with views and macros for the logs loaded.
          --ui  also start the DuckDB UI on the same session and open it in a new
                browser tab (installs the ui extension on first use, which needs
                network access)

  run PQDIR FILE.sql
        Run a SQL file in such a session.

Environment: DUCKDB (default: duckdb from PATH).
EOF
}

msg()  { echo "bench-parquet: $*" >&2; }
die()  { msg "$*"; exit 1; }
# A SQL string literal.
sqlq() { local s=${1//\'/\'\'}; printf "'%s'" "$s"; }
# A SQL quoted identifier.
sqli() { local s=${1//\"/\"\"}; printf '"%s"' "$s"; }

# A converted directory (PQDIR): <process>.parquet files and meta/.
check_pqdir() {
    local pq=$1
    test -d "$pq" || die "not a directory: $pq"
    test -f "$pq"/meta/files.parquet ||
        die "no meta/files.parquet in $pq (not written by bench-parquet convert)"
}

##############################################################################
# convert

# Convert one log file. Runs as a background job; all output to stderr.
convert_one() {
    local src=$1 process=$2 dst=$3 stats=$4 spill=$5 mem=$6 threads=$7 zstd=$8

    local size sha final_nl
    size=$(stat -L -c%s "$src")
    if test "$size" -eq 0
    then final_nl=false
    elif test "$(tail -c1 "$src" | wc -l)" -eq 1
    then final_nl=true
    else final_nl=false
    fi

    mkdir -p "$spill"
    stats_sql() {
        echo "SELECT $(sqlq "$process") AS process,
                     $(sqlq "$src") AS source, ${size}::UBIGINT AS size_bytes,
                     $(sqlq "$sha") AS sha256, ${final_nl} AS final_newline"
    }

    if test "$size" -eq 0
    then
        sha=$(sha256sum "$src" | cut -d' ' -f1)
        local stats_sql; stats_sql=$(stats_sql)
        "$DUCKDB" -init /dev/null -c "
            COPY (SELECT NULL::VARCHAR AS process, NULL::UBIGINT AS seq, NULL::TIMESTAMP_NS AS \"at\",
                         NULL::VARCHAR AS ns, NULL::VARCHAR AS sev, NULL::VARCHAR AS thread,
                         NULL::VARCHAR AS host, NULL::VARCHAR AS data, NULL::VARCHAR AS line
                  WHERE false)
              TO $(sqlq "$dst") (FORMAT parquet, COMPRESSION zstd, COMPRESSION_LEVEL $zstd, ROW_GROUP_SIZE $row_group_size);
            COPY (SELECT *, 0::UBIGINT AS lines_total, 0::UBIGINT AS lines_json, 0::UBIGINT AS lines_text,
                         0::UBIGINT AS lines_text_after_json, 0::UBIGINT AS lines_json_verbatim
                  FROM ($stats_sql))
              TO $(sqlq "$stats") (FORMAT parquet);" >/dev/null
        return
    fi

    local script
    script=$(mktemp -p "$spill" convert.XXXXXX.sql)
    cat > "$script" <<EOF
SET memory_limit = '$mem';
SET threads = $threads;
SET temp_directory = $(sqlq "$spill");
.read $(sqlq "$sql_dir/lib.sql")
.read $(sqlq "$sql_dir/convert.sql")
COPY (FROM bp_parse($(sqlq "$process"), '/dev/stdin') ORDER BY ns NULLS LAST, "at", seq)
TO $(sqlq "$dst") (FORMAT parquet, COMPRESSION zstd, COMPRESSION_LEVEL $zstd, ROW_GROUP_SIZE $row_group_size);
EOF
    # One read of the log feeds the sha256 (through a named pipe), the checks for
    # characters the line reader can't carry through unchanged (CR, the ASCII
    # record separator 0x1e; awk fails at the end if it saw any) and the line
    # numbering for DuckDB.
    local fifo=$spill/sha256.fifo shafile=$spill/sha256 shapid
    mkfifo "$fifo"
    sha256sum < "$fifo" > "$shafile" & shapid=$!
    local status=0
    tee "$fifo" < "$src" |
        awk -v label="$process" '
            /[\r\036]/ { if (index($0, "\r")) cr++; if (index($0, "\036")) rs++ }
            { printf "%d\037%s\n", NR, $0 }
            END { if (cr) printf "bench-parquet: %s: %d lines contain CR; not supported\n", label, cr > "/dev/stderr"
                  if (rs) printf "bench-parquet: %s: %d lines contain the ASCII record separator (0x1e); not supported\n", label, rs > "/dev/stderr"
                  if (cr || rs) exit 3 }' |
        "$DUCKDB" -init /dev/null -c ".read $(sqlq "$script")" >/dev/null || status=$?
    wait $shapid || true
    test $status -eq 0 || return $status
    sha=$(cut -d' ' -f1 "$shafile")
    test ${#sha} -eq 64 || { msg "$process: no sha256 computed"; return 1; }

    # Statistics from the written file.
    local stats_sql; stats_sql=$(stats_sql)
    "$DUCKDB" -init /dev/null -c ".read $(sqlq "$sql_dir/lib.sql")" -c ".read $(sqlq "$sql_dir/convert.sql")" -c "
        COPY (SELECT s.*, st.* FROM ($stats_sql) s, bp_file_stats($(sqlq "$dst")) st)
          TO $(sqlq "$stats") (FORMAT parquet);" >/dev/null
}

# Memory this process may use, in MiB, and where the figure comes from:
# MemAvailable, lowered by the tightest cgroup memory limit on the way up the
# hierarchy (a Nomad alloc's limit may sit on a parent cgroup). Page cache counts
# towards a cgroup's usage but is reclaimable, so usage excludes file pages.
mem_available() {
    local avail src=MemAvailable path d max used room
    avail=$(awk '/^MemAvailable:/ { printf "%d", $2 / 1024 }' /proc/meminfo)
    path=$(awk -F: '$1 == "0" { print $3; exit }' /proc/self/cgroup 2>/dev/null)
    if test -n "$path" -a -r /sys/fs/cgroup/cgroup.controllers
    then # cgroup v2
         d=/sys/fs/cgroup${path%/}
         while :
         do if test -r "$d/memory.max" -a -r "$d/memory.current" -a -r "$d/memory.stat"
            then max=$(cat "$d/memory.max")
                 if test "$max" != max
                 then used=$(( $(cat "$d/memory.current") - $(awk '$1 == "file" { print $2 }' "$d/memory.stat") ))
                      room=$(( (max - used) / 1048576 ))
                      if test $room -lt "$avail"
                      then avail=$room; src="cgroup ${d#/sys/fs/cgroup}"; fi
                 fi
            fi
            test "$d" = /sys/fs/cgroup && break
            d=$(dirname "$d")
         done
    else # cgroup v1
         path=$(awk -F: '$2 ~ /(^|,)memory(,|$)/ { print $3; exit }' /proc/self/cgroup 2>/dev/null)
         d=/sys/fs/cgroup/memory${path%/}
         if test -n "$path" -a -r "$d/memory.limit_in_bytes" -a -r "$d/memory.usage_in_bytes"
         then max=$(cat "$d/memory.limit_in_bytes")
              if test ${#max} -lt 19      # unlimited is ~2^63
              then used=$(( $(cat "$d/memory.usage_in_bytes") - $(awk '$1 == "total_cache" { print $2 }' "$d/memory.stat") ))
                   room=$(( (max - used) / 1048576 ))
                   if test $room -lt "$avail"
                   then avail=$room; src="cgroup v1 $path"; fi
              fi
         fi
    fi
    test "$avail" -ge 0 || avail=0
    echo "$avail $src"
}

convert_cmd() {
    local out= run_id= system_start= slot_length= force= mem_gib=4 jobs= keep_temp= zstd=$zstd_default
    local -A file_of=()
    local a process file
    while test $# -gt 0
    do case "$1" in
           --run-id )       run_id=${2:?--run-id needs an identifier}; shift;;
           --system-start ) system_start=${2:?--system-start needs a timestamp}; shift;;
           --slot-length )  slot_length=${2:?--slot-length needs seconds}; shift;;
           --force )        force=t;;
           --jobs )         jobs=${2:?--jobs needs a number}; shift;;
           --keep-temp )    keep_temp=t;;
           --zstd-level )   zstd=${2:?--zstd-level needs a number}; shift;;
           -* )             die "convert: unknown option: $1";;
           *=* )            a=$1; process=${a%%=*}; file=${a#*=}
                            [[ $process =~ ^[A-Za-z0-9._-]+$ ]] && test "$process" != meta ||
                                die "convert: not a process name (letters, digits, . _ -; not 'meta'): $process"
                            test -z "${file_of[$process]:-}" || die "convert: process given twice: $process"
                            test -f "$file" || die "convert: no such file: $file"
                            file_of[$process]=$(realpath -s "$file");;
           * )              test -z "$out" || die "convert: more than one PQDIR (logs are PROCESS=FILE)"; out=$1;;
       esac; shift; done
    test -n "$out" || die "convert: PQDIR missing"
    test -n "$run_id" || die "convert: --run-id missing"
    test ${#file_of[@]} -gt 0 || die "convert: no PROCESS=FILE given"
    test -z "$system_start" -a -z "$slot_length" -o -n "$system_start" -a -n "$slot_length" ||
        die "convert: --system-start and --slot-length go together"
    command -v "$DUCKDB" >/dev/null || die "duckdb not found (DUCKDB=$DUCKDB)"
    out=$(realpath -m "$out")
    test -d "$(dirname "$out")" || die "convert: no such directory: $(dirname "$out")"
    if test -e "$out" -a -z "$force"
    then die "$out exists (use --force to replace it)"; fi

    # Largest first: the longest conversion starts at once and overlaps with the
    # rest instead of running alone at the end.
    local -A size_of=()
    local sources=() total=0 src
    for src in "${!file_of[@]}"
    do size_of[$src]=$(stat -L -c%s "${file_of[$src]}"); total=$(( total + size_of[$src] )); done
    mapfile -t sources < <(for src in "${!file_of[@]}"; do printf '%s\t%s\n' "${size_of[$src]}" "$src"; done |
                           sort -t$'\t' -k1,1nr -k2,2 | cut -f2)

    # Parallelism: memory budget per slot = DuckDB's limit + 1.5 GiB for what it
    # uses beyond the limit (measured: 0.7 GiB over for a 4 GiB job, 2.7 GiB over
    # for an 8 GiB job of 2 slots), and 4 DuckDB threads per slot.
    local threads=4 ncpu mem_avail_mib mem_src budget_mib
    ncpu=$(nproc)
    budget_mib=$(( mem_gib * 1024 + 1536 ))
    read -r mem_avail_mib mem_src < <(mem_available)
    if test -z "$jobs"
    then jobs=$(( mem_avail_mib / budget_mib ))
         test $jobs -le $(( ncpu / threads )) || jobs=$(( ncpu / threads ))
         test $jobs -ge 1 || jobs=1
    fi

    # Slots per log: a log larger than an even share of the work (total / jobs)
    # would finish last on one slot; it gets its share of the slots instead,
    # round(size * jobs / total), as one job with that many times the threads and
    # memory, so it ends about when the rest does. Memory stays within budget.
    # (Rounding, not ceiling: two equal halves of the work get half the slots each.)
    local -A slots_of=()
    local k
    for src in "${sources[@]}"
    do if test "$total" -gt 0 -a $(( size_of[$src] * jobs )) -gt "$total"
       then k=$(( (2 * size_of[$src] * jobs + total) / (2 * total) ))
            test $k -le "$jobs" || k=$jobs
       else k=1; fi
       slots_of[$src]=$k
    done

    local tmp; tmp=$(dirname "$out")/.$(basename "$out").tmp.$$
    mkdir -p "$tmp"/spill "$tmp"/stats "$tmp"/meta
    msg "converting ${#sources[@]} logs of $run_id: $jobs slots, each ${threads} threads and ${mem_gib} GiB memory limit"
    msg "  memory available: $(( mem_avail_mib / 1024 )) GiB ($mem_src), cores: $ncpu"
    for src in "${sources[@]}"
    do test "${slots_of[$src]}" -eq 1 ||
           msg "  $src ($(( size_of[$src] / 1048576 )) MiB of $(( total / 1048576 )) MiB): ${slots_of[$src]} slots"
    done

    local -A running=() started=() weight=()
    local failed=() src label pid status used=0
    reap_one() {
        if wait -n -p pid; then status=0; else status=$?; fi
        label=${running[$pid]}
        local took=$(( SECONDS - started[$pid] ))
        used=$(( used - weight[$pid] ))
        unset "running[$pid]" "started[$pid]" "weight[$pid]"
        if test $status -eq 0
        then msg "done: $label in ${took} s (at $(( SECONDS - t0 )) s)"
        else msg "failed: $label (exit $status, after ${took} s)"; failed+=("$label"); fi
    }
    local t0=$SECONDS
    for src in "${sources[@]}"
    do process=$src
       k=${slots_of[$src]}
       while test $(( used + k )) -gt "$jobs"; do reap_one; done
       convert_one "${file_of[$src]}" "$process" \
                   "$tmp/$process.parquet" "$tmp/stats/$process.parquet" \
                   "$tmp/spill/$process" "$(( k * mem_gib ))GiB" "$(( k * threads ))" "$zstd" &
       running[$!]=$src
       started[$!]=$SECONDS
       weight[$!]=$k
       used=$(( used + k ))
    done
    while test ${#running[@]} -gt 0; do reap_one; done

    if test ${#failed[@]} -gt 0
    then if test -n "$keep_temp"
         then msg "kept $tmp"
         else rm -rf "$tmp"; fi
         die "${#failed[@]} of ${#sources[@]} conversions failed: ${failed[*]}"
    fi

    # Metadata. Genesis timing is NULL when not given (query sessions then refuse
    # slot arithmetic instead of guessing).
    local start_sql=NULL slot_sql=NULL
    if test -n "$system_start"
    then start_sql="CAST($(sqlq "${system_start%Z}") AS TIMESTAMP)"
         slot_sql="CAST($(sqlq "$slot_length") AS DOUBLE)"; fi
    "$DUCKDB" -init /dev/null -c "
        COPY (SELECT * FROM read_parquet($(sqlq "$tmp/stats/*.parquet")) ORDER BY process)
          TO $(sqlq "$tmp/meta/files.parquet") (FORMAT parquet);
        COPY (SELECT $(sqlq "$run_id")                       AS run_id,
                     CAST($start_sql AS TIMESTAMP)           AS system_start,
                     CAST($slot_sql AS DOUBLE)               AS slot_length_s,
                     $(sqlq "$converter_version")            AS converter_version,
                     ${raw_schema_version}::INTEGER          AS raw_schema_version,
                     version()                               AS duckdb_version,
                     CAST(now() AT TIME ZONE 'UTC' AS TIMESTAMP) AS created)
          TO $(sqlq "$tmp/meta/run.parquet") (FORMAT parquet);" >/dev/null
    rm -rf "$tmp"/spill "$tmp"/stats

    # Namespaces differing only in case can't coexist as views (DuckDB matches
    # identifiers case-insensitively, even quoted). Views are made for the nodes only.
    local clashes=
    compgen -G "$tmp/node-*.parquet" >/dev/null &&
    clashes=$("$DUCKDB" -init /dev/null -noheader -list -c "
        SELECT string_agg(DISTINCT ns, ' / ') FROM read_parquet($(sqlq "$tmp/node-*.parquet"))
        WHERE ns IS NOT NULL GROUP BY lower(ns) HAVING count(DISTINCT ns) > 1;")
    if test -n "$clashes"
    then msg "namespaces differing only in case (only one gets a view):"
         echo "$clashes" | sed 's/^/  /' >&2; fi

    if test -e "$out"
    then mv "$out" "$tmp.old"; mv "$tmp" "$out"; rm -rf "$tmp.old"
    else mv "$tmp" "$out"; fi

    # Summary: totals, then only the logs worth a look.
    local files=$(sqlq "$out/meta/files.parquet") notable
    local cond="lines_text_after_json > 0 OR lines_json_verbatim > 0"
    "$DUCKDB" -init /dev/null -c "
        SELECT count(*) AS logs, sum(size_bytes) AS size_bytes, sum(lines_total) AS lines_total,
               sum(lines_json) AS lines_json, sum(lines_text) AS lines_text,
               sum(lines_text_after_json) AS lines_text_after_json,
               sum(lines_json_verbatim) AS lines_json_verbatim
        FROM read_parquet($files);" >&2
    notable=$("$DUCKDB" -init /dev/null -noheader -list -c "SELECT count(*) FROM read_parquet($files) WHERE $cond;")
    if test "$notable" -gt 0
    then msg "$notable logs with text after JSON started, or JSON lines kept verbatim:"
         "$DUCKDB" -init /dev/null -c "
            SELECT process, size_bytes, lines_total, lines_json, lines_text,
                   lines_text_after_json, lines_json_verbatim
            FROM read_parquet($files) WHERE $cond ORDER BY process;" >&2
    else msg "no log with text after JSON started, or JSON lines kept verbatim"
    fi
    msg "wrote $out ($(du -sh "$out" | cut -f1)) in $(( SECONDS - t0 )) s"
}

##############################################################################
# Sessions

# Write the session init script for a run to FILE.
session_init() {
    local pq=$1 file=$2
    compgen -G "$pq/node-*.parquet" >/dev/null ||
        die "no node-*.parquet in $pq: query sessions need at least one node log (process named node-*)"
    local pql session
    pql=$(sqlq "$pq")
    session=$(<"$sql_dir/session.sql")
    {
        echo ".read $(sqlq "$sql_dir/lib.sql")"
        # Quoted replacement: no & expansion (bash 5.2 patsub_replacement).
        printf '%s\n' "${session//@PARQUETS@/"$pql"}"
        if test -f "$pq/generator.parquet"
        then echo "CREATE OR REPLACE VIEW raw_generator AS SELECT * FROM read_parquet($(sqlq "$pq/generator.parquet"));"
        else echo "CREATE OR REPLACE VIEW raw_generator AS SELECT * FROM raw WHERE false;"
        fi
        # One view per namespace the nodes emit, named by the quoted namespace.
        # Nodes only: a generator namespace never shadows or mixes into these.
        "$DUCKDB" -init /dev/null -noheader -list -c "
            SELECT DISTINCT ns FROM read_parquet($(sqlq "$pq/node-*.parquet"))
            WHERE ns IS NOT NULL ORDER BY ns;" |
        while IFS= read -r ns
        do echo "CREATE OR REPLACE VIEW $(sqli "$ns") AS SELECT * FROM raw WHERE ns = $(sqlq "$ns");"
        done
        local f
        for f in "$sql_dir"/curated/*.sql
        do test -f "$f" && echo ".read $(sqlq "$f")"; done
    } > "$file"
}

with_session() {
    local pq=$1; shift
    pq=$(realpath -m "$pq")
    check_pqdir "$pq"
    local init status=0
    init=$(mktemp --suffix=.sql)
    session_init "$pq" "$init"
    "$@" "$init" || status=$?
    rm -f "$init"
    return $status
}

query_cmd() {
    local pq=${1:?query: PQDIR missing}; shift
    local ui= args=() a
    for a in "$@"
    do if test "$a" = --ui; then ui=t; else args+=("$a"); fi; done
    run_query() {
        test -z "$ui" || echo ".read $(sqlq "$sql_dir/ui.sql")" >> "$1"
        "$DUCKDB" -init "$1" "${args[@]}"
    }
    with_session "$pq" run_query
}

run_cmd() {
    local pq=${1:?run: PQDIR missing} file=${2:?run: FILE.sql missing}
    test -f "$file" || die "no such file: $file"
    file=$(realpath "$file")
    run_file() { "$DUCKDB" -init /dev/null -c ".read $(sqlq "$1")" -c ".read $(sqlq "$file")"; }
    with_session "$pq" run_file
}

##############################################################################
# restore

restore_cmd() {
    local pq= process= outf= verify=
    while test $# -gt 0
    do case "$1" in
           -o )       outf=${2:?-o needs a file}; shift;;
           --verify ) verify=t;;
           -* )       die "restore: unknown option: $1";;
           * )        if   test -z "$pq";      then pq=$1
                      elif test -z "$process"; then process=$1
                      else die "restore: too many arguments"; fi;;
       esac; shift; done
    test -n "$pq" -a -n "$process" -a -n "$outf" || die "restore: PQDIR PROCESS -o FILE required"
    pq=$(realpath -m "$pq")
    local pqf; pqf=$(process_parquet "$pq" "$process")

    local meta
    meta=$("$DUCKDB" -init /dev/null -noheader -list -separator $'\t' -c "
        SELECT final_newline, lines_total, sha256, source FROM read_parquet($(sqlq "$pq/meta/files.parquet"))
        WHERE process = $(sqlq "$process");")
    test -n "$meta" || die "no metadata for $process"
    local final_nl lines sha source
    IFS=$'\t' read -r final_nl lines sha source <<< "$meta"
    # Never over the log it was converted from (the path recorded at conversion).
    test "$(realpath -m "$outf")" != "$(realpath -m "$source")" || die "refusing to overwrite the original $source"

    "$DUCKDB" -init /dev/null >/dev/null <<EOF
.read $(sqlq "$sql_dir/lib.sql")
COPY (SELECT bp_line(t) FROM read_parquet($(sqlq "$pqf")) t ORDER BY seq)
  TO $(sqlq "$outf") (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER E'\x1e');
EOF
    # COPY ends every line with a newline; the original may not have had a final one.
    if test "$final_nl" = false -a "$lines" -gt 0
    then truncate -s -1 "$outf"; fi

    if test -n "$verify"
    then local got
         got=$(sha256sum "$outf" | cut -d' ' -f1)
         if test "$got" = "$sha"
         then msg "verified: $outf matches the sha256 recorded at conversion"
         else die "verification failed: $outf has sha256 $got, recorded at conversion: $sha"; fi
    fi
}

##############################################################################
# lines, host-summary: input for locli prepare-db-from-lines

# The Parquet file of one process, after checks.
process_parquet() {
    local pq=$1 process=$2
    check_pqdir "$pq"
    local pqf=$pq/$process.parquet
    test -f "$pqf" || die "no $pqf"
    echo "$pqf"
}

lines_cmd() {
    local pq= process= nsfile=
    while test $# -gt 0
    do case "$1" in
           --ns-file ) nsfile=${2:?--ns-file needs a file}; shift;;
           -* )        die "lines: unknown option: $1";;
           * )         if   test -z "$pq";      then pq=$1
                       elif test -z "$process"; then process=$1
                       else die "lines: too many arguments"; fi;;
       esac; shift; done
    test -n "$pq" -a -n "$process" || die "lines: PQDIR PROCESS required"
    pq=$(realpath -m "$pq")
    local pqf; pqf=$(process_parquet "$pq" "$process")

    local filter="ns IS NOT NULL" ns list=()
    if test -n "$nsfile"
    then test -r "$nsfile" || die "lines: can't read $nsfile"
         while IFS= read -r ns
         do test -n "$ns" && list+=("$(sqlq "$ns")"); done < "$nsfile"
         test ${#list[@]} -gt 0 || die "lines: no namespaces in $nsfile"
         filter="ns IN ($(IFS=,; echo "${list[*]}"))"
    fi

    # Restoring log order sorts the selected lines: bounded memory, spilling
    # beside PQDIR (several of these may run in parallel, one per host).
    local tmp; tmp=$(dirname "$pq")/.$(basename "$pq").lines.tmp.$$
    mkdir -p "$tmp"
    local status=0
    "$DUCKDB" -init /dev/null <<EOF || status=$?
SET memory_limit = '2GiB';
SET threads = 2;
SET temp_directory = $(sqlq "$tmp");
.read $(sqlq "$sql_dir/lib.sql")
COPY (SELECT bp_line(t) FROM read_parquet($(sqlq "$pqf")) t WHERE $filter ORDER BY seq)
  TO '/dev/stdout' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER E'\x1e');
EOF
    rm -rf "$tmp"
    return $status
}

host_summary_cmd() {
    local pq=${1:?host-summary: PQDIR missing} process=${2:?host-summary: PROCESS missing}
    test $# -eq 2 || die "host-summary: too many arguments"
    pq=$(realpath -m "$pq")
    local pqf; pqf=$(process_parquet "$pq" "$process")
    "$DUCKDB" -init /dev/null -noheader -list <<EOF
.read $(sqlq "$sql_dir/lib.sql")
.read $(sqlq "$sql_dir/locli.sql")
FROM bp_host_summary($(sqlq "$pqf"));
EOF
}

head_tail_cmd() {
    local cmd=$1; shift
    local pq= process= n=20
    while test $# -gt 0
    do case "$1" in
           -n ) n=${2:?-n needs a number}; shift;;
           -* ) die "$cmd: unknown option: $1";;
           * )  if   test -z "$pq";      then pq=$1
                elif test -z "$process"; then process=$1
                else die "$cmd: too many arguments"; fi;;
       esac; shift; done
    test -n "$pq" -a -n "$process" || die "$cmd: PQDIR PROCESS required"
    [[ $n =~ ^[0-9]+$ ]] || die "$cmd: -n needs a number, got: $n"
    pq=$(realpath -m "$pq")
    local pqf; pqf=$(process_parquet "$pq" "$process")
    "$DUCKDB" -init /dev/null <<EOF
.read $(sqlq "$sql_dir/lib.sql")
COPY (FROM bp_$cmd($(sqlq "$pqf"), $n))
  TO '/dev/stdout' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER E'\x1e');
EOF
}

##############################################################################
# excerpt

excerpt_cmd() {
    local pq= at= ns= where=true before=5 after=5 outdir= processes=()
    while test $# -gt 0
    do case "$1" in
           --at )      at=${2:?--at needs a timestamp}; shift;;
           --ns )      ns=${2:?--ns needs a namespace}; shift;;
           --where )   where=${2:?--where needs an SQL condition}; shift;;
           --before )  before=${2:?}; shift;;
           --after )   after=${2:?}; shift;;
           --process ) processes+=("${2:?}"); shift;;
           -o )        outdir=${2:?-o needs a directory}; shift;;
           -* )        die "excerpt: unknown option: $1";;
           * )         test -z "$pq" || die "excerpt: more than one PQDIR"; pq=$1;;
       esac; shift; done
    test -n "$pq" -a -n "$outdir" || die "excerpt: PQDIR and -o OUTDIR required"
    test -n "$at" -o -n "$ns" || die "excerpt: --at or --ns required"
    pq=$(realpath -m "$pq")
    check_pqdir "$pq"

    local pfilter=true p
    if test ${#processes[@]} -gt 0
    then pfilter="process IN ($(for p in "${processes[@]}"; do printf '%s,' "$(sqlq "$p")"; done | sed 's/,$//'))"; fi

    local anchor_sql
    if test -n "$at"
    then anchor_sql="SELECT epoch_ns(CAST($(sqlq "${at%Z}") AS TIMESTAMP_NS))"
    else anchor_sql="SELECT epoch_ns(min(\"at\")) FROM read_parquet($(sqlq "$pq/*.parquet"))
                     WHERE ns = $(sqlq "$ns") AND ($where) AND $pfilter"
    fi
    local anchor
    anchor=$("$DUCKDB" -init /dev/null -noheader -list -nullvalue '' -c "$anchor_sql;")
    test -n "$anchor" || die "excerpt: no event of $ns matching: $where"

    mkdir -p "$outdir"
    local list
    list=$("$DUCKDB" -init /dev/null -noheader -list -c "
        SELECT DISTINCT process FROM read_parquet($(sqlq "$pq/*.parquet"))
        WHERE $pfilter ORDER BY process;")
    {
        echo ".read $(sqlq "$sql_dir/lib.sql")"
        echo "CREATE TEMP TABLE w AS
                SELECT process, seq, bp_line(t) AS l
                FROM read_parquet($(sqlq "$pq/*.parquet")) t
                WHERE $pfilter
                  AND epoch_ns(\"at\") BETWEEN $anchor - CAST($before * 1e9 AS BIGINT)
                                           AND $anchor + CAST($after  * 1e9 AS BIGINT);"
        while IFS= read -r p
        do echo "COPY (SELECT l FROM w WHERE process = $(sqlq "$p") ORDER BY seq)
                   TO $(sqlq "$outdir/$p.stdout") (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER E'\x1e');"
        done <<< "$list"
        echo "SELECT process, count(*) AS lines FROM w GROUP BY process ORDER BY process;"
    } > "$outdir/.excerpt.sql"
    "$DUCKDB" -init /dev/null -c ".read $(sqlq "$outdir/.excerpt.sql")" >&2
    rm -f "$outdir/.excerpt.sql"
    msg "window: $("$DUCKDB" -init /dev/null -noheader -list -c "SELECT make_timestamp_ns($anchor)") -${before}s / +${after}s; files in $outdir"
}

##############################################################################

cmd=${1:-}; test $# -eq 0 || shift
case "$cmd" in
    convert )     convert_cmd "$@";;
    restore )     restore_cmd "$@";;
    excerpt )     excerpt_cmd "$@";;
    lines )       lines_cmd "$@";;
    host-summary ) host_summary_cmd "$@";;
    head | tail ) head_tail_cmd "$cmd" "$@";;
    query )       query_cmd "$@";;
    run )         run_cmd "$@";;
    help | -h | --help | "" ) usage;;
    * )           usage >&2; exit 1;;
esac
