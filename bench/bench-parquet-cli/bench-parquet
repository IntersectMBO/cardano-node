#!/usr/bin/env bash
# bench-parquet: process logs <-> Parquet, and querying them.
# Prototype (bash + SQL). See README.md.
set -euo pipefail

self_dir=$(dirname "$(realpath "${BASH_SOURCE[0]}")")
sql_dir=$self_dir/sql
DUCKDB=${DUCKDB:-duckdb}

converter_version=0.3
# 2: column at renamed to ts (at is reserved in DuckDB: unquoted, it's a syntax error).
raw_schema_version=2
zstd_default=15
# Rows per row group. Smaller than DuckDB's default (122,880) so that reading the payload
# of a small namespace decompresses less of its neighbours: queries on a few namespaces
# run several times faster, for about 2 % more size.
row_group_size=32768

usage() {
    cat <<EOF
Usage: bench-parquet COMMAND ARGS..

PQDIR is a directory written by convert: one <process>.parquet per log, plus
meta/files.parquet and meta/run.parquet. Every command except convert needs only it.

  convert PQDIR --run-id ID [--system-start TIMESTAMP --slot-length SECS]
          [--epoch-length SLOTS] [--force | --add] [--jobs N] [--keep-temp]
          [--zstd-level N] PROCESS=FILE..
        Convert each log FILE into PQDIR/PROCESS.parquet, losslessly, plus
        meta/files.parquet and meta/run.parquet. A process named node-* is a
        node, generator the generator (query sessions tell them apart by name).
          --run-id ID     the run's identifier, recorded in meta/run.parquet
          --system-start TIMESTAMP, --slot-length SECS
                          genesis system start (UTC) and slot length; without
                          them, slot arithmetic in query sessions is an error
          --epoch-length SLOTS
                          genesis epoch length; without it, run_epoch_length()
                          in query sessions is an error
          --force         replace an existing PQDIR (only once the new one is complete)
          --add           to an existing PQDIR, convert only the logs it lacks (no
                          PROCESS.parquet with metadata); the run id and converter
                          version must match the recorded ones, genesis values it
                          lacks are added, differing ones are an error
          --jobs N        slots (default: from available memory and cores); a log larger
                          than total size / slots gets its share of the slots
          --keep-temp     keep the temporary directory when a conversion fails
          --zstd-level N  zstd compression level (default: $zstd_default)

  restore PQDIR PROCESS -o FILE [--verify]
        Reconstruct a process's log. --verify checks the sha256 recorded at
        conversion. Refuses to write over the converted log itself while it
        exists (restoring it after deletion is fine).
  restore PQDIR PROCESS=FILE.. [--jobs N]
        The same for several logs, scheduled like convert; each FILE is written
        through FILE.restoring and renamed only once verified; an existing FILE
        is skipped. Exit status 1 if any log failed.

  verify PQDIR [PROCESS..] [--jobs N]
        Rebuild each log (default: all) in memory and compare its sha256 with the
        one recorded at conversion; nothing is written. On stdout one line per
        log, "PROCESS<TAB>ok" or "PROCESS<TAB>failed"; exit status 1 if any failed.
        --jobs N as for convert.

  head PQDIR PROCESS [-n N]
  tail PQDIR PROCESS [-n N]
        The first / last N lines (default 20) of the process's log on stdout,
        byte for byte as in the original, text lines included.

  excerpt PQDIR (--at TIMESTAMP | --ns NAMESPACE [--where SQL]) [--before SECS] [--after SECS]
          [--process P].. -o OUTDIR
        Original log lines in a time window around a timestamp, or around the
        first event of NAMESPACE (optionally matching the SQL condition on its
        columns, e.g. "data->>'\$.slot' = '991'"), one file per process in OUTDIR.
        Defaults: --before 5 --after 5, all processes.

  lines PQDIR PROCESS [--ns-file FILE]
        The process's JSON lines on stdout, byte for byte as in the original log
        and in its order; with --ns-file only those of the namespaces listed in
        FILE (one per line). For locli prepare-db-from-lines.

  host-summary PQDIR PROCESS
        JSON on stdout: line counts per namespace ("tracefreqs"), the number of
        JSON lines ("lines"), and the timestamps of the first and the last JSON
        line in log order ("firstAt", "lastAt"). For locli prepare-db-from-lines.

  query PQDIR [--ui] [--load PATH].. [DUCKDB-ARGS..]
        Interactive DuckDB session with views and macros for the logs loaded.
          --ui         also start the DuckDB UI on the same session and open it in
                       a new browser tab (installs the ui extension on first use,
                       which needs network access)
          --load PATH  also read PATH into the session, after the package views:
                       a SQL file, or every *.sql directly in a directory, in byte
                       order of the file names; repeatable, read in the order given
                       (e.g. user_sql/views/, user_sql/queries/locli/)

  run PQDIR [--load PATH].. (FILE.sql | NAME)
        Run a SQL file in such a session; NAME (no "/", no ".sql") is a prepared
        query of the package, sql/queries/*/NAME.sql (e.g. heap_bumps).

  check PQDIR [NAME..]
        Run the package checks (sql/checks/; default: all, NAME with or without
        the chk_ prefix) in such a session. On stdout, tab-separated, one line per
        violation: violation, check, process, ts, observed, expected; and one
        line "none", check, -, -, none, - per check without violations. Exit
        status 0 whatever the checks find (judging them is the caller's part).

Environment: DUCKDB (default: duckdb from PATH).
EOF
}

msg()  { echo "bench-parquet: $*" >&2; }
die()  { msg "$*"; exit 1; }
# A SQL string literal.
sqlq() { local s=${1//\'/\'\'}; printf "'%s'" "$s"; }
# A SQL quoted identifier.
sqli() { local s=${1//\"/\"\"}; printf '"%s"' "$s"; }

# A converted directory (PQDIR): <process>.parquet files and meta/.
check_pqdir() {
    local pq=$1
    test -d "$pq" || die "not a directory: $pq"
    test -f "$pq"/meta/files.parquet ||
        die "no meta/files.parquet in $pq (not written by bench-parquet convert)"
    local v
    v=$("$DUCKDB" -init /dev/null -noheader -list -c "
        SELECT raw_schema_version FROM read_parquet($(sqlq "$pq/meta/run.parquet"));")
    test "$v" = "$raw_schema_version" ||
        die "$pq has raw schema version $v; this bench-parquet reads version $raw_schema_version (convert again)"
}

##############################################################################
# Scheduling of per-log jobs (convert, verify). Both functions work on the
# calling command's variables (bash's dynamic scope): sources (log names),
# size_of (bytes per log), jobs (empty: from memory and cores), slots_of, total,
# and failed.

# Per slot: DuckDB's memory limit and threads.
slot_mem_gib=4 slot_threads=4

# Orders sources largest first and sets jobs, total and slots_of; also
# mem_avail_mib, ncpu and mem_src, for the caller's messages.
plan_slots() {
    local src k budget_mib
    # Largest first: the longest job starts at once and overlaps with the rest
    # instead of running alone at the end.
    total=0
    for src in "${sources[@]}"; do total=$(( total + size_of[$src] )); done
    mapfile -t sources < <(for src in "${sources[@]}"; do printf '%s\t%s\n' "${size_of[$src]}" "$src"; done |
                           sort -t$'\t' -k1,1nr -k2,2 | cut -f2)

    # Parallelism: memory budget per slot = DuckDB's limit + 1.5 GiB for what it
    # uses beyond the limit (up to ~0.7 GiB per 4 GiB slot, more for jobs of
    # several slots), and slot_threads DuckDB threads per slot.
    budget_mib=$(( slot_mem_gib * 1024 + 1536 ))
    read -r mem_avail_mib ncpu mem_src < <(resources)
    if test -z "$jobs"
    then jobs=$(( mem_avail_mib / budget_mib ))
         test $jobs -le $(( ncpu / slot_threads )) || jobs=$(( ncpu / slot_threads ))
         test $jobs -ge 1 || jobs=1
    fi

    # Slots per log: a log larger than an even share of the work (total / jobs)
    # would finish last on one slot; it gets its share of the slots instead,
    # round(size * jobs / total), as one job with that many times the threads and
    # memory, so it ends about when the rest does. Memory stays within budget.
    # (Rounding, not ceiling: two equal halves of the work get half the slots each.)
    for src in "${sources[@]}"
    do if test "$total" -gt 0 -a $(( size_of[$src] * jobs )) -gt "$total"
       then k=$(( (2 * size_of[$src] * jobs + total) / (2 * total) ))
            test $k -le "$jobs" || k=$jobs
       else k=1; fi
       slots_of[$src]=$k
    done
}

# Runs "LAUNCH SOURCE SLOTS" for each source as a background job, in the order
# of sources, with at most jobs slots in use; failed gets the sources whose job
# failed.
run_slots() {
    local launch=$1
    local -A running=() started=() weight=()
    local src label pid status used=0 k t_run=$SECONDS
    reap_one() {
        if wait -n -p pid; then status=0; else status=$?; fi
        label=${running[$pid]}
        local took=$(( SECONDS - started[$pid] ))
        used=$(( used - weight[$pid] ))
        unset "running[$pid]" "started[$pid]" "weight[$pid]"
        if test $status -eq 0
        then msg "done: $label in ${took} s (at $(( SECONDS - t_run )) s)"
        else msg "failed: $label (exit $status, after ${took} s)"; failed+=("$label"); fi
    }
    for src in "${sources[@]}"
    do k=${slots_of[$src]}
       while test $(( used + k )) -gt "$jobs"; do reap_one; done
       "$launch" "$src" "$k" &
       running[$!]=$src
       started[$!]=$SECONDS
       weight[$!]=$k
       used=$(( used + k ))
    done
    while test ${#running[@]} -gt 0; do reap_one; done
}

##############################################################################
# convert

# Convert one log file. Runs as a background job; all output to stderr.
convert_one() {
    local src=$1 process=$2 dst=$3 stats=$4 spill=$5 mem=$6 threads=$7 zstd=$8

    local size sha final_nl
    size=$(stat -L -c%s "$src")
    if test "$size" -eq 0
    then final_nl=false
    elif test "$(tail -c1 "$src" | wc -l)" -eq 1
    then final_nl=true
    else final_nl=false
    fi

    mkdir -p "$spill"
    stats_sql() {
        echo "SELECT $(sqlq "$process") AS process,
                     $(sqlq "$src") AS source, ${size}::UBIGINT AS size_bytes,
                     $(sqlq "$sha") AS sha256, ${final_nl} AS final_newline"
    }

    if test "$size" -eq 0
    then
        sha=$(sha256sum "$src" | cut -d' ' -f1)
        local stats_sql; stats_sql=$(stats_sql)
        "$DUCKDB" -init /dev/null -c "
            COPY (SELECT NULL::VARCHAR AS process, NULL::UBIGINT AS seq, NULL::TIMESTAMP_NS AS ts,
                         NULL::VARCHAR AS ns, NULL::VARCHAR AS sev, NULL::VARCHAR AS thread,
                         NULL::VARCHAR AS host, NULL::VARCHAR AS data, NULL::VARCHAR AS line
                  WHERE false)
              TO $(sqlq "$dst") (FORMAT parquet, COMPRESSION zstd, COMPRESSION_LEVEL $zstd, ROW_GROUP_SIZE $row_group_size);
            COPY (SELECT *, 0::UBIGINT AS lines_total, 0::UBIGINT AS lines_json, 0::UBIGINT AS lines_text,
                         0::UBIGINT AS lines_text_after_json, 0::UBIGINT AS lines_json_verbatim
                  FROM ($stats_sql))
              TO $(sqlq "$stats") (FORMAT parquet);" >/dev/null
        return
    fi

    local script
    script=$(mktemp -p "$spill" convert.XXXXXX.sql)
    cat > "$script" <<EOF
SET memory_limit = '$mem';
SET threads = $threads;
SET temp_directory = $(sqlq "$spill");
.read $(sqlq "$sql_dir/lib.sql")
.read $(sqlq "$sql_dir/convert.sql")
COPY (FROM bp_parse($(sqlq "$process"), '/dev/stdin') ORDER BY ns NULLS LAST, ts, seq)
TO $(sqlq "$dst") (FORMAT parquet, COMPRESSION zstd, COMPRESSION_LEVEL $zstd, ROW_GROUP_SIZE $row_group_size);
EOF
    # One read of the log feeds the sha256 (through a named pipe), the checks for
    # characters the line reader can't carry through unchanged (CR, the ASCII
    # record separator 0x1e; awk fails at the end if it saw any) and the line
    # numbering for DuckDB.
    local fifo=$spill/sha256.fifo shafile=$spill/sha256 shapid
    mkfifo "$fifo"
    sha256sum < "$fifo" > "$shafile" & shapid=$!
    local status=0
    tee "$fifo" < "$src" |
        awk -v label="$process" '
            /[\r\036]/ { if (index($0, "\r")) cr++; if (index($0, "\036")) rs++ }
            { printf "%d\037%s\n", NR, $0 }
            END { if (cr) printf "bench-parquet: %s: %d lines contain CR; not supported\n", label, cr > "/dev/stderr"
                  if (rs) printf "bench-parquet: %s: %d lines contain the ASCII record separator (0x1e); not supported\n", label, rs > "/dev/stderr"
                  if (cr || rs) exit 3 }' |
        "$DUCKDB" -init /dev/null -c ".read $(sqlq "$script")" >/dev/null || status=$?
    wait $shapid || true
    test $status -eq 0 || return $status
    sha=$(cut -d' ' -f1 "$shafile")
    test ${#sha} -eq 64 || { msg "$process: no sha256 computed"; return 1; }

    # Statistics from the written file.
    local stats_sql; stats_sql=$(stats_sql)
    "$DUCKDB" -init /dev/null -c ".read $(sqlq "$sql_dir/lib.sql")" -c ".read $(sqlq "$sql_dir/convert.sql")" -c "
        COPY (SELECT s.*, st.* FROM ($stats_sql) s, bp_file_stats($(sqlq "$dst")) st)
          TO $(sqlq "$stats") (FORMAT parquet);" >/dev/null
}

# Memory (MiB) and cores for conversion, and where the memory figure comes from:
# RAM or the cgroup limit as DuckDB sees them (bp_resources, portable), lowered on
# Linux to MemAvailable, i.e. to what other processes leave free.
resources() {
    local mem cores avail src="RAM or cgroup limit, via DuckDB"
    read -r mem cores < <("$DUCKDB" -init /dev/null -noheader -list -separator ' ' \
                              -c ".read $(sqlq "$sql_dir/lib.sql")" -c ".read $(sqlq "$sql_dir/convert.sql")" \
                              -c "FROM bp_resources();")
    test -n "$cores" || die "could not read memory and cores from DuckDB"
    if test -r /proc/meminfo
    then avail=$(awk '/^MemAvailable:/ { printf "%d", $2 / 1024 }' /proc/meminfo)
         if test -n "$avail" && test "$avail" -lt "$mem"; then mem=$avail; src=MemAvailable; fi
    fi
    echo "$mem $cores $src"
}

convert_cmd() {
    local out= run_id= system_start= slot_length= epoch_length= force= add= jobs= keep_temp= zstd=$zstd_default
    local -A file_of=()
    local a process file
    while test $# -gt 0
    do case "$1" in
           --run-id )       run_id=${2:?--run-id needs an identifier}; shift;;
           --system-start ) system_start=${2:?--system-start needs a timestamp}; shift;;
           --slot-length )  slot_length=${2:?--slot-length needs seconds}; shift;;
           --epoch-length ) epoch_length=${2:?--epoch-length needs a number of slots}; shift
                            [[ $epoch_length =~ ^[1-9][0-9]*$ ]] ||
                                die "convert: --epoch-length: not a number of slots: $epoch_length";;
           --force )        force=t;;
           --add )          add=t;;
           --jobs )         jobs=${2:?--jobs needs a number}; shift;;
           --keep-temp )    keep_temp=t;;
           --zstd-level )   zstd=${2:?--zstd-level needs a number}; shift;;
           -* )             die "convert: unknown option: $1";;
           *=* )            a=$1; process=${a%%=*}; file=${a#*=}
                            [[ $process =~ ^[A-Za-z0-9._-]+$ ]] && test "$process" != meta ||
                                die "convert: not a process name (letters, digits, . _ -; not 'meta'): $process"
                            test -z "${file_of[$process]:-}" || die "convert: process given twice: $process"
                            test -f "$file" || die "convert: no such file: $file"
                            file_of[$process]=$(realpath -s "$file");;
           * )              test -z "$out" || die "convert: more than one PQDIR (logs are PROCESS=FILE)"; out=$1;;
       esac; shift; done
    test -n "$out" || die "convert: PQDIR missing"
    test -n "$run_id" || die "convert: --run-id missing"
    test ${#file_of[@]} -gt 0 || die "convert: no PROCESS=FILE given"
    test -z "$system_start" -a -z "$slot_length" -o -n "$system_start" -a -n "$slot_length" ||
        die "convert: --system-start and --slot-length go together"
    test -z "$force" -o -z "$add" || die "convert: --force and --add exclude each other"
    command -v "$DUCKDB" >/dev/null || die "duckdb not found (DUCKDB=$DUCKDB)"
    out=$(realpath -m "$out")
    test -d "$(dirname "$out")" || die "convert: no such directory: $(dirname "$out")"
    if test -e "$out" -a -z "$force" -a -z "$add"
    then die "$out exists (use --force to replace it, or --add to convert only the logs it lacks)"; fi

    # Genesis values as SQL; NULL when not given (query sessions then refuse
    # slot and epoch arithmetic instead of guessing).
    local start_sql=NULL slot_sql=NULL epoch_sql=NULL
    if test -n "$system_start"
    then start_sql="CAST($(sqlq "${system_start%Z}") AS TIMESTAMP)"
         slot_sql="CAST($(sqlq "$slot_length") AS DOUBLE)"; fi
    test -z "$epoch_length" || epoch_sql=$epoch_length

    # --add to an existing PQDIR: the recorded metadata must agree (checked now,
    # before converting anything), and logs it has are skipped.
    local adding= merge_sql= process_
    if test -n "$add" -a -e "$out"
    then check_pqdir "$out"
         adding=t
         merge_sql="FROM bp_merge_run_meta($(sqlq "$out/meta/run.parquet"), $(sqlq "$run_id"),
                        $start_sql, $slot_sql, $epoch_sql, $(sqlq "$converter_version"))"
         "$DUCKDB" -init /dev/null -c ".read $(sqlq "$sql_dir/lib.sql")" -c ".read $(sqlq "$sql_dir/convert.sql")" -c "$merge_sql;" >/dev/null ||
             die "convert --add: $out doesn't match (see above)"
         while IFS= read -r process_
         do if test -n "${file_of[$process_]:-}" -a -f "$out/$process_.parquet"
            then msg "$process_: in $out already, skipped"; unset "file_of[$process_]"; fi
         done < <("$DUCKDB" -init /dev/null -noheader -list -c "
                      SELECT process FROM read_parquet($(sqlq "$out/meta/files.parquet"));")
    fi

    local -A size_of=() slots_of=()
    local sources=() total=0 src mem_avail_mib ncpu mem_src
    for src in "${!file_of[@]}"
    do size_of[$src]=$(stat -L -c%s "${file_of[$src]}"); sources+=("$src"); done
    plan_slots

    local tmp; tmp=$(dirname "$out")/.$(basename "$out").tmp.$$
    mkdir -p "$tmp"/spill "$tmp"/stats "$tmp"/meta
    # Roles come from process names (node-*, generator); anything else is
    # converted but not part of a query session's raw or raw_generator.
    for src in "${sources[@]}"
    do case "$src" in node-* | generator ) ;;
           * ) msg "$src: not named node-* or generator; not in a query session's raw or raw_generator";; esac
    done
    if test ${#sources[@]} -eq 0
    then msg "no log to convert: $out has all of them"
    else msg "converting ${#sources[@]} logs of $run_id: $jobs slots, each ${slot_threads} threads and ${slot_mem_gib} GiB memory limit"
         msg "  memory available: $(( mem_avail_mib / 1024 )) GiB ($mem_src), cores: $ncpu"
    fi
    for src in "${sources[@]}"
    do test "${slots_of[$src]}" -eq 1 ||
           msg "  $src ($(( size_of[$src] / 1048576 )) MiB of $(( total / 1048576 )) MiB): ${slots_of[$src]} slots"
    done

    convert_job() {
        convert_one "${file_of[$1]}" "$1" "$tmp/$1.parquet" "$tmp/stats/$1.parquet" \
                    "$tmp/spill/$1" "$(( $2 * slot_mem_gib ))GiB" "$(( $2 * slot_threads ))" "$zstd"
    }
    local failed=() t0=$SECONDS
    run_slots convert_job

    if test ${#failed[@]} -gt 0
    then if test -n "$keep_temp"
         then msg "kept $tmp"
         else rm -rf "$tmp"; fi
         die "${#failed[@]} of ${#sources[@]} conversions failed: ${failed[*]}"
    fi

    # Metadata. With --add: the recorded files plus the new ones, and the recorded
    # run row with the genesis values it lacked (bp_merge_run_meta).
    if test -n "$adding"
    then local new_files="SELECT * FROM read_parquet($(sqlq "$tmp/stats/*.parquet"))"
         test ${#sources[@]} -gt 0 || new_files="SELECT * FROM read_parquet($(sqlq "$out/meta/files.parquet")) WHERE false"
         "$DUCKDB" -init /dev/null -c ".read $(sqlq "$sql_dir/lib.sql")" -c ".read $(sqlq "$sql_dir/convert.sql")" -c "
            COPY (SELECT * FROM read_parquet($(sqlq "$out/meta/files.parquet"))
                  WHERE process NOT IN (SELECT process FROM ($new_files))
                  UNION ALL BY NAME ($new_files) ORDER BY process)
              TO $(sqlq "$tmp/meta/files.parquet") (FORMAT parquet);
            COPY ($merge_sql) TO $(sqlq "$tmp/meta/run.parquet") (FORMAT parquet);" >/dev/null
    else
    "$DUCKDB" -init /dev/null -c "
        COPY (SELECT * FROM read_parquet($(sqlq "$tmp/stats/*.parquet")) ORDER BY process)
          TO $(sqlq "$tmp/meta/files.parquet") (FORMAT parquet);
        COPY (SELECT $(sqlq "$run_id")                       AS run_id,
                     CAST($start_sql AS TIMESTAMP)           AS system_start,
                     CAST($slot_sql AS DOUBLE)               AS slot_length_s,
                     CAST($epoch_sql AS BIGINT)              AS epoch_length,
                     $(sqlq "$converter_version")            AS converter_version,
                     ${raw_schema_version}::INTEGER          AS raw_schema_version,
                     version()                               AS duckdb_version,
                     CAST(now() AT TIME ZONE 'UTC' AS TIMESTAMP) AS created)
          TO $(sqlq "$tmp/meta/run.parquet") (FORMAT parquet);" >/dev/null
    fi
    rm -rf "$tmp"/spill "$tmp"/stats

    # Into place: the whole directory, or with --add the new logs, then the
    # metadata that lists them.
    if test -n "$adding"
    then for src in "${sources[@]}"; do mv "$tmp/$src.parquet" "$out/$src.parquet"; done
         mv "$tmp/meta/files.parquet" "$out/meta/files.parquet"
         mv "$tmp/meta/run.parquet" "$out/meta/run.parquet"
         rm -rf "$tmp"
    elif test -e "$out"
    then mv "$out" "$tmp.old"; mv "$tmp" "$out"; rm -rf "$tmp.old"
    else mv "$tmp" "$out"; fi

    # Namespaces differing only in case can't coexist as views (DuckDB matches
    # identifiers case-insensitively, even quoted). Views are made for the nodes only.
    local clashes=
    compgen -G "$out/node-*.parquet" >/dev/null &&
    clashes=$("$DUCKDB" -init /dev/null -noheader -list -c "
        SELECT string_agg(DISTINCT ns, ' / ') FROM read_parquet($(sqlq "$out/node-*.parquet"))
        WHERE ns IS NOT NULL GROUP BY lower(ns) HAVING count(DISTINCT ns) > 1;")
    if test -n "$clashes"
    then msg "namespaces differing only in case (only one gets a view):"
         echo "$clashes" | sed 's/^/  /' >&2; fi

    # Summary: totals, then only the logs worth a look.
    local files=$(sqlq "$out/meta/files.parquet") notable
    local cond="lines_text_after_json > 0 OR lines_json_verbatim > 0"
    "$DUCKDB" -init /dev/null -c "
        SELECT count(*) AS logs, sum(size_bytes) AS size_bytes, sum(lines_total) AS lines_total,
               sum(lines_json) AS lines_json, sum(lines_text) AS lines_text,
               sum(lines_text_after_json) AS lines_text_after_json,
               sum(lines_json_verbatim) AS lines_json_verbatim
        FROM read_parquet($files);" >&2
    notable=$("$DUCKDB" -init /dev/null -noheader -list -c "SELECT count(*) FROM read_parquet($files) WHERE $cond;")
    if test "$notable" -gt 0
    then msg "$notable logs with text after JSON started, or JSON lines kept verbatim:"
         "$DUCKDB" -init /dev/null -c "
            SELECT process, size_bytes, lines_total, lines_json, lines_text,
                   lines_text_after_json, lines_json_verbatim
            FROM read_parquet($files) WHERE $cond ORDER BY process;" >&2
    else msg "no log with text after JSON started, or JSON lines kept verbatim"
    fi
    msg "wrote $out ($(du -sh "$out" | cut -f1)) in $(( SECONDS - t0 )) s"
}

##############################################################################
# Sessions

# Write the session init script for a run to FILE.
session_init() {
    local pq=$1 file=$2
    compgen -G "$pq/node-*.parquet" >/dev/null ||
        die "no node-*.parquet in $pq: query sessions need at least one node log (process named node-*)"
    local pql session
    pql=$(sqlq "$pq")
    session=$(<"$sql_dir/session.sql")
    {
        echo ".read $(sqlq "$sql_dir/lib.sql")"
        # Quoted replacement: no & expansion (bash 5.2 patsub_replacement).
        printf '%s\n' "${session//@PARQUETS@/"$pql"}"
        if test -f "$pq/generator.parquet"
        then echo "CREATE OR REPLACE VIEW raw_generator AS SELECT * FROM read_parquet($(sqlq "$pq/generator.parquet"));"
        else echo "CREATE OR REPLACE VIEW raw_generator AS SELECT * FROM raw WHERE false;"
        fi
        # One view per namespace the nodes emit, named by the quoted namespace.
        # Nodes only: a generator namespace never shadows or mixes into these.
        "$DUCKDB" -init /dev/null -noheader -list -c "
            SELECT DISTINCT ns FROM read_parquet($(sqlq "$pq/node-*.parquet"))
            WHERE ns IS NOT NULL ORDER BY ns;" |
        while IFS= read -r ns
        do echo "CREATE OR REPLACE VIEW $(sqli "$ns") AS SELECT * FROM raw WHERE ns = $(sqlq "$ns");"
        done
        # Package views by tier, then the checks (sql/README.md): a view uses only
        # lower tiers, and DuckDB binds a view's references at creation.
        local f
        for f in "$sql_dir"/views/[0-9]*/*.sql "$sql_dir"/checks/*.sql
        do test -f "$f" && echo ".read $(sqlq "$f")"; done
    } > "$file"
}

with_session() {
    local pq=$1; shift
    pq=$(realpath -m "$pq")
    check_pqdir "$pq"
    local init status=0
    init=$(mktemp --suffix=.sql)
    session_init "$pq" "$init"
    "$@" "$init" || status=$?
    rm -f "$init"
    return $status
}

# --load PATH: the .read lines for a SQL file, for a directory every *.sql
# directly in it, in byte order of the file names (independent of the locale).
# Bail mode off first, and left off: an error in one of them is printed and the
# session goes on (user_sql/README.md). DuckDB ends a session whose init file
# had an error unless bail mode is off when the init file ends.
load_reads() {
    local p f
    test $# -gt 0 || return 0
    echo ".bail off"
    for p in "$@"
    do if test -d "$p"
       then while IFS= read -r -d '' f
            do echo ".read $(sqlq "$f")"
            done < <(find "$p" -maxdepth 1 -type f -name '*.sql' -print0 | LC_ALL=C sort -z)
       else echo ".read $(sqlq "$p")"
       fi
    done
}

# A --load argument, checked and made absolute (sessions run elsewhere).
load_path() {
    test -n "$1" || die "--load needs a path"
    test -f "$1" -o -d "$1" || die "--load: no such file or directory: $1"
    realpath "$1"
}

query_cmd() {
    local pq=${1:?query: PQDIR missing}; shift
    local ui= args=() loads=()
    while test $# -gt 0
    do case "$1" in
           --ui )   ui=t;;
           --load ) loads+=("$(load_path "${2:-}")") || exit 1; shift;;
           * )      args+=("$1");;
       esac; shift; done
    run_query() {
        load_reads "${loads[@]}" >> "$1"
        test -z "$ui" || echo ".read $(sqlq "$sql_dir/ui.sql")" >> "$1"
        "$DUCKDB" -init "$1" "${args[@]}"
    }
    with_session "$pq" run_query
}

run_cmd() {
    local pq=${1:?run: PQDIR missing}; shift
    local file= loads=()
    while test $# -gt 0
    do case "$1" in
           --load ) loads+=("$(load_path "${2:-}")") || exit 1; shift;;
           -* )     die "run: unknown option: $1";;
           * )      test -z "$file" || die "run: more than one FILE.sql"; file=$1;;
       esac; shift; done
    test -n "$file" || die "run: FILE.sql or a prepared query's NAME missing"
    if [[ $file != */* && $file != *.sql ]]
    then # A prepared query by name.
         local found=() f
         for f in "$sql_dir"/queries/*/"$file".sql; do test -f "$f" && found+=("$f"); done
         if test ${#found[@]} -ne 1
         then local names=()
              for f in "$sql_dir"/queries/*/*.sql; do names+=("$(basename "$f" .sql)"); done
              test ${#found[@]} -eq 0 ||
                  die "run: $file names several prepared queries: ${found[*]#"$sql_dir"/}"
              die "run: no prepared query $file; there are: ${names[*]}"
         fi
         file=${found[0]}
    fi
    test -f "$file" || die "no such file: $file"
    file=$(realpath "$file")
    run_file() {
        if test ${#loads[@]} -eq 0
        then "$DUCKDB" -init /dev/null -c ".read $(sqlq "$1")" -c ".read $(sqlq "$file")"
        else load_reads "${loads[@]}" >> "$1"
             # As the init file (see load_reads); FILE itself stops at its first
             # error, with a non-zero exit status.
             "$DUCKDB" -init "$1" -cmd ".bail on" -c ".read $(sqlq "$file")"
        fi
    }
    with_session "$pq" run_file
}

check_cmd() {
    local pq=${1:?check: PQDIR missing}; shift
    local all=() names=() n f
    for f in "$sql_dir"/checks/*.sql; do all+=("$(basename "$f" .sql)"); done
    if test $# -eq 0
    then names=("${all[@]}")
    else for n in "$@"
         do n=chk_${n#chk_}
            [[ " ${all[*]} " == *" $n "* ]] || die "check: no check $n (checks: ${all[*]})"
            names+=("$n")
         done
    fi
    # Each check evaluated once (a materialized CTE), its rows or one "none" row.
    local ctes=() selects=()
    for n in "${names[@]}"
    do ctes+=("$n AS MATERIALIZED (FROM $n)")
       selects+=("SELECT 'violation' AS result, check_name, process, CAST(ts AS VARCHAR) AS ts, observed, expected FROM $n")
       selects+=("SELECT 'none', $(sqlq "${n#chk_}"), NULL, NULL, 'none', NULL WHERE NOT EXISTS (FROM $n)")
    done
    local sql="WITH $(IFS=,; echo "${ctes[*]}") $(printf '%s UNION ALL ' "${selects[@]}" | sed 's/ UNION ALL $//') ORDER BY 2, 1 DESC, 3, 4;"
    check_run() {
        "$DUCKDB" -init /dev/null -noheader -list -separator $'\t' -nullvalue - \
                  -c ".read $(sqlq "$1")" -c "$sql"
    }
    with_session "$pq" check_run
}

##############################################################################
# restore

# Restore one log: rebuilt by DuckDB within the given memory and threads
# (spilling to spill), the final newline as in the original, and with verify the
# written file's sha256 checked against the recorded one.
restore_one() {
    local pqf=$1 outf=$2 final_nl=$3 lines=$4 sha=$5 mem=$6 threads=$7 spill=$8 verify=$9
    mkdir -p "$spill"
    "$DUCKDB" -init /dev/null >/dev/null <<EOF || { rm -rf "$spill"; return 1; }
SET memory_limit = '$mem';
SET threads = $threads;
SET temp_directory = $(sqlq "$spill");
.read $(sqlq "$sql_dir/lib.sql")
COPY (FROM bp_log($(sqlq "$pqf")))
  TO $(sqlq "$outf") (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER E'\x1e');
EOF
    rm -rf "$spill"
    # COPY ends every line with a newline; the original may not have had a final one.
    if test "$final_nl" = false -a "$lines" -gt 0
    then truncate -s -1 "$outf"; fi
    if test -n "$verify"
    then local got
         got=$(sha256sum "$outf" | cut -d' ' -f1)
         if test "$got" = "$sha"
         then msg "verified: $outf matches the sha256 recorded at conversion"
         else msg "verification failed: $outf has sha256 $got, recorded at conversion: $sha"; return 1; fi
    fi
}

restore_cmd() {
    local pq= process= outf= verify= jobs= a
    local -A file_of=()
    while test $# -gt 0
    do case "$1" in
           -o )       outf=${2:?-o needs a file}; shift;;
           --verify ) verify=t;;
           --jobs )   jobs=${2:?--jobs needs a number}; shift;;
           -* )       die "restore: unknown option: $1";;
           *=* )      test -n "$pq" || die "restore: PQDIR first"
                      a=$1; test -z "${file_of[${a%%=*}]:-}" || die "restore: process given twice: ${a%%=*}"
                      file_of[${a%%=*}]=$(realpath -m "${a#*=}");;
           * )        if   test -z "$pq";      then pq=$1
                      elif test -z "$process"; then process=$1
                      else die "restore: too many arguments"; fi;;
       esac; shift; done
    test -n "$pq" || die "restore: PQDIR missing"
    if test ${#file_of[@]} -gt 0
    then test -z "$process" -a -z "$outf" || die "restore: either PROCESS -o FILE or PROCESS=FILE.., not both"
    else test -n "$process" -a -n "$outf" || die "restore: PQDIR PROCESS -o FILE, or PQDIR PROCESS=FILE.., required"
         file_of[$process]=$(realpath -m "$outf")
    fi
    pq=$(realpath -m "$pq")
    check_pqdir "$pq"

    # Metadata of the requested logs.
    local -A size_of=() slots_of=() nl_of=() lines_of=() sha_of=() source_of=()
    local p size final_nl lines sha source
    while IFS=$'\t' read -r p size final_nl lines sha source
    do test -n "${file_of[$p]:-}" || continue
       size_of[$p]=$size nl_of[$p]=$final_nl lines_of[$p]=$lines sha_of[$p]=$sha source_of[$p]=$source
    done < <("$DUCKDB" -init /dev/null -noheader -list -separator $'\t' -c "
                 SELECT process, size_bytes, final_newline, lines_total, sha256, source
                 FROM read_parquet($(sqlq "$pq/meta/files.parquet"));")
    local sources=() skipped=0
    for p in "${!file_of[@]}"
    do test -n "${size_of[$p]:-}" -a -f "$pq/$p.parquet" || die "restore: no log $p in $pq"
       if test -n "$process"
       then # Never over the log it was converted from (the path recorded at
            # conversion), while it exists.
            test "${file_of[$p]}" != "$(realpath -m "${source_of[$p]}")" -o ! -e "${source_of[$p]}" ||
                die "refusing to overwrite the original ${source_of[$p]}"
       elif test -e "${file_of[$p]}"
       then msg "$p: ${file_of[$p]} exists, skipped"; skipped=$(( skipped + 1 )); continue
       fi
       sources+=("$p")
    done
    local total=0 mem_avail_mib ncpu mem_src
    plan_slots
    local spill=$(dirname "$pq")/.$(basename "$pq").restore.$$

    # PROCESS -o FILE: one log, written in place, all slots.
    if test -n "$process"
    then restore_one "$pq/$process.parquet" "${file_of[$process]}" "${nl_of[$process]}" "${lines_of[$process]}" \
                     "${sha_of[$process]}" "$(( slots_of[$process] * slot_mem_gib ))GiB" \
                     "$(( slots_of[$process] * slot_threads ))" "$spill" "$verify" || exit 1
         return 0
    fi

    # PROCESS=FILE..: scheduled, each through FILE.restoring, renamed once verified.
    test ${#sources[@]} -gt 0 && msg "restoring ${#sources[@]} logs: $jobs slots, each ${slot_threads} threads and ${slot_mem_gib} GiB memory limit"
    restore_job() {
        local p=$1 k=$2 f=${file_of[$1]}
        mkdir -p "$(dirname "$f")"
        if restore_one "$pq/$p.parquet" "$f.restoring" "${nl_of[$p]}" "${lines_of[$p]}" "${sha_of[$p]}" \
                       "$(( k * slot_mem_gib ))GiB" "$(( k * slot_threads ))" "$spill/$p" t
        then mv "$f.restoring" "$f"
        else rm -f "$f.restoring"; return 1; fi
    }
    local failed=()
    run_slots restore_job
    rm -rf "$spill"
    msg "restored $(( ${#sources[@]} - ${#failed[@]} )), skipped $skipped (file exists)"
    test ${#failed[@]} -eq 0 || die "${#failed[@]} of ${#sources[@]} logs not restored: ${failed[*]}"
}

##############################################################################
# verify

verify_cmd() {
    local pq= jobs= requested=() p
    while test $# -gt 0
    do case "$1" in
           --jobs ) jobs=${2:?--jobs needs a number}; shift;;
           -* )     die "verify: unknown option: $1";;
           * )      if test -z "$pq"; then pq=$1; else requested+=("$1"); fi;;
       esac; shift; done
    test -n "$pq" || die "verify: PQDIR missing"
    pq=$(realpath -m "$pq")
    check_pqdir "$pq"

    local -A size_of=() slots_of=() sha_of=() trim_of=()
    local sources=() total=0 src mem_avail_mib ncpu mem_src size final_nl lines sha
    while IFS=$'\t' read -r p size final_nl lines sha
    do size_of[$p]=$size sha_of[$p]=$sha
       # COPY ends every line with a newline; the original may not have had a final one.
       if test "$final_nl" = false -a "$lines" -gt 0; then trim_of[$p]=t; else trim_of[$p]=; fi
    done < <("$DUCKDB" -init /dev/null -noheader -list -separator $'\t' -c "
                 SELECT process, size_bytes, final_newline, lines_total, sha256
                 FROM read_parquet($(sqlq "$pq/meta/files.parquet"));")
    if test ${#requested[@]} -gt 0
    then for p in "${requested[@]}"
         do test -n "${size_of[$p]:-}" || die "verify: no log $p in $pq"; sources+=("$p"); done
    else sources=("${!size_of[@]}"); fi
    plan_slots

    local spill; spill=$(dirname "$pq")/.$(basename "$pq").verify.$$
    msg "verifying ${#sources[@]} logs: $jobs slots, each ${slot_threads} threads and ${slot_mem_gib} GiB memory limit"
    # One job: the rebuilt log streamed into sha256sum (bp_log; spilling to disk
    # where it doesn't fit the memory limit).
    verify_job() {
        local p=$1 k=$2 got
        mkdir -p "$spill/$p"
        got=$(set -o pipefail
              "$DUCKDB" -init /dev/null -c ".read $(sqlq "$sql_dir/lib.sql")" -c "
                  SET memory_limit = '$(( k * slot_mem_gib ))GiB';
                  SET threads = $(( k * slot_threads ));
                  SET temp_directory = $(sqlq "$spill/$p");
                  COPY (FROM bp_log($(sqlq "$pq/$p.parquet")))
                    TO '/dev/stdout' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER E'\x1e');" |
                  if test -n "${trim_of[$p]}"; then head -c -1; else cat; fi |
                  sha256sum | cut -d' ' -f1) || got=
        rm -rf "$spill/$p"
        if test "$got" = "${sha_of[$p]}"
        then printf '%s\tok\n' "$p"
        else printf '%s\tfailed\n' "$p"
             msg "$p: sha256 ${got:-(not computed)}, recorded at conversion: ${sha_of[$p]}"
             return 1
        fi
    }
    local failed=()
    run_slots verify_job
    rm -rf "$spill"
    test ${#failed[@]} -eq 0 || die "${#failed[@]} of ${#sources[@]} logs failed verification: ${failed[*]}"
    msg "verified ${#sources[@]} logs"
}

##############################################################################
# lines, host-summary: input for locli prepare-db-from-lines

# The Parquet file of one process, after checks.
process_parquet() {
    local pq=$1 process=$2
    check_pqdir "$pq"
    local pqf=$pq/$process.parquet
    test -f "$pqf" || die "no $pqf"
    echo "$pqf"
}

lines_cmd() {
    local pq= process= nsfile=
    while test $# -gt 0
    do case "$1" in
           --ns-file ) nsfile=${2:?--ns-file needs a file}; shift;;
           -* )        die "lines: unknown option: $1";;
           * )         if   test -z "$pq";      then pq=$1
                       elif test -z "$process"; then process=$1
                       else die "lines: too many arguments"; fi;;
       esac; shift; done
    test -n "$pq" -a -n "$process" || die "lines: PQDIR PROCESS required"
    pq=$(realpath -m "$pq")
    local pqf; pqf=$(process_parquet "$pq" "$process")

    local filter="ns IS NOT NULL" ns list=()
    if test -n "$nsfile"
    then test -r "$nsfile" || die "lines: can't read $nsfile"
         while IFS= read -r ns
         do test -n "$ns" && list+=("$(sqlq "$ns")"); done < "$nsfile"
         test ${#list[@]} -gt 0 || die "lines: no namespaces in $nsfile"
         filter="ns IN ($(IFS=,; echo "${list[*]}"))"
    fi

    # Restoring log order sorts the selected lines: bounded memory, spilling
    # beside PQDIR (several of these may run in parallel, one per host).
    local tmp; tmp=$(dirname "$pq")/.$(basename "$pq").lines.tmp.$$
    mkdir -p "$tmp"
    local status=0
    "$DUCKDB" -init /dev/null <<EOF || status=$?
SET memory_limit = '2GiB';
SET threads = 2;
SET temp_directory = $(sqlq "$tmp");
.read $(sqlq "$sql_dir/lib.sql")
COPY (SELECT bp_line(t) FROM read_parquet($(sqlq "$pqf")) t WHERE $filter ORDER BY seq)
  TO '/dev/stdout' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER E'\x1e');
EOF
    rm -rf "$tmp"
    return $status
}

host_summary_cmd() {
    local pq=${1:?host-summary: PQDIR missing} process=${2:?host-summary: PROCESS missing}
    test $# -eq 2 || die "host-summary: too many arguments"
    pq=$(realpath -m "$pq")
    local pqf; pqf=$(process_parquet "$pq" "$process")
    "$DUCKDB" -init /dev/null -noheader -list <<EOF
.read $(sqlq "$sql_dir/lib.sql")
.read $(sqlq "$sql_dir/locli.sql")
FROM bp_host_summary($(sqlq "$pqf"));
EOF
}

head_tail_cmd() {
    local cmd=$1; shift
    local pq= process= n=20
    while test $# -gt 0
    do case "$1" in
           -n ) n=${2:?-n needs a number}; shift;;
           -* ) die "$cmd: unknown option: $1";;
           * )  if   test -z "$pq";      then pq=$1
                elif test -z "$process"; then process=$1
                else die "$cmd: too many arguments"; fi;;
       esac; shift; done
    test -n "$pq" -a -n "$process" || die "$cmd: PQDIR PROCESS required"
    [[ $n =~ ^[0-9]+$ ]] || die "$cmd: -n needs a number, got: $n"
    pq=$(realpath -m "$pq")
    local pqf; pqf=$(process_parquet "$pq" "$process")
    "$DUCKDB" -init /dev/null <<EOF
.read $(sqlq "$sql_dir/lib.sql")
COPY (FROM bp_$cmd($(sqlq "$pqf"), $n))
  TO '/dev/stdout' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER E'\x1e');
EOF
}

##############################################################################
# excerpt

excerpt_cmd() {
    local pq= at= ns= where=true before=5 after=5 outdir= processes=()
    while test $# -gt 0
    do case "$1" in
           --at )      at=${2:?--at needs a timestamp}; shift;;
           --ns )      ns=${2:?--ns needs a namespace}; shift;;
           --where )   where=${2:?--where needs an SQL condition}; shift;;
           --before )  before=${2:?}; shift;;
           --after )   after=${2:?}; shift;;
           --process ) processes+=("${2:?}"); shift;;
           -o )        outdir=${2:?-o needs a directory}; shift;;
           -* )        die "excerpt: unknown option: $1";;
           * )         test -z "$pq" || die "excerpt: more than one PQDIR"; pq=$1;;
       esac; shift; done
    test -n "$pq" -a -n "$outdir" || die "excerpt: PQDIR and -o OUTDIR required"
    test -n "$at" -o -n "$ns" || die "excerpt: --at or --ns required"
    pq=$(realpath -m "$pq")
    check_pqdir "$pq"

    local pfilter=true p
    if test ${#processes[@]} -gt 0
    then pfilter="process IN ($(for p in "${processes[@]}"; do printf '%s,' "$(sqlq "$p")"; done | sed 's/,$//'))"; fi

    local anchor_sql
    if test -n "$at"
    then anchor_sql="SELECT epoch_ns(CAST($(sqlq "${at%Z}") AS TIMESTAMP_NS))"
    else anchor_sql="SELECT epoch_ns(min(ts)) FROM read_parquet($(sqlq "$pq/*.parquet"))
                     WHERE ns = $(sqlq "$ns") AND ($where) AND $pfilter"
    fi
    local anchor
    anchor=$("$DUCKDB" -init /dev/null -noheader -list -nullvalue '' -c "$anchor_sql;")
    test -n "$anchor" || die "excerpt: no event of $ns matching: $where"

    mkdir -p "$outdir"
    local list
    list=$("$DUCKDB" -init /dev/null -noheader -list -c "
        SELECT DISTINCT process FROM read_parquet($(sqlq "$pq/*.parquet"))
        WHERE $pfilter ORDER BY process;")
    {
        echo ".read $(sqlq "$sql_dir/lib.sql")"
        echo "CREATE TEMP TABLE w AS
                SELECT process, seq, bp_line(t) AS l
                FROM read_parquet($(sqlq "$pq/*.parquet")) t
                WHERE $pfilter
                  AND epoch_ns(ts) BETWEEN $anchor - CAST($before * 1e9 AS BIGINT)
                                           AND $anchor + CAST($after  * 1e9 AS BIGINT);"
        while IFS= read -r p
        do echo "COPY (SELECT l FROM w WHERE process = $(sqlq "$p") ORDER BY seq)
                   TO $(sqlq "$outdir/$p.stdout") (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', DELIMITER E'\x1e');"
        done <<< "$list"
        echo "SELECT process, count(*) AS lines FROM w GROUP BY process ORDER BY process;"
    } > "$outdir/.excerpt.sql"
    "$DUCKDB" -init /dev/null -c ".read $(sqlq "$outdir/.excerpt.sql")" >&2
    rm -f "$outdir/.excerpt.sql"
    msg "window: $("$DUCKDB" -init /dev/null -noheader -list -c "SELECT make_timestamp_ns($anchor)") -${before}s / +${after}s; files in $outdir"
}

##############################################################################

cmd=${1:-}; test $# -eq 0 || shift
case "$cmd" in
    convert )     convert_cmd "$@";;
    restore )     restore_cmd "$@";;
    verify )      verify_cmd "$@";;
    excerpt )     excerpt_cmd "$@";;
    lines )       lines_cmd "$@";;
    host-summary ) host_summary_cmd "$@";;
    head | tail ) head_tail_cmd "$cmd" "$@";;
    query )       query_cmd "$@";;
    run )         run_cmd "$@";;
    check )       check_cmd "$@";;
    help | -h | --help | "" ) usage;;
    * )           usage >&2; exit 1;;
esac
