#!/usr/bin/env bash
# bench-parquet: process logs <-> Parquet, and querying them.
# Prototype (bash + SQL). See README.md.
set -euo pipefail

self_dir=$(dirname "$(realpath "${BASH_SOURCE[0]}")")
sql_dir=$self_dir/sql
DUCKDB=${DUCKDB:-duckdb}

converter_version=0.3
# 2: column at renamed to ts (at is reserved in DuckDB: unquoted, it's a syntax error).
raw_schema_version=2
zstd_default=15
# Rows per row group. Smaller than DuckDB's default (122,880) so that reading the payload
# of a small namespace decompresses less of its neighbours: queries on a few namespaces
# run several times faster, for about 2 % more size.
row_group_size=32768

usage() {
    cat <<EOF
Usage: bench-parquet COMMAND ARGS..

PQDIR is a directory written by convert: one <process>.parquet per log, plus
meta/files.parquet and meta/run.parquet. Every command except convert needs only it.

  convert PQDIR --run-id ID [--system-start TIMESTAMP --slot-length SECS]
          [--epoch-length SLOTS] [--force | --add] [--jobs N] [--keep-temp]
          [--zstd-level N] PROCESS=FILE..
        Convert each log FILE into PQDIR/PROCESS.parquet, losslessly, plus
        meta/files.parquet and meta/run.parquet. A process named node-* is a
        node, generator the generator (query sessions tell them apart by name).
          --run-id ID     the run's identifier, recorded in meta/run.parquet
          --system-start TIMESTAMP, --slot-length SECS
                          genesis system start (UTC) and slot length; without
                          them, slot arithmetic in query sessions is an error
          --epoch-length SLOTS
                          genesis epoch length; without it, run_epoch_length()
                          in query sessions is an error
          --force         replace an existing PQDIR (only once the new one is complete)
          --add           to an existing PQDIR, convert only the logs it lacks (no
                          PROCESS.parquet with metadata); the run id and converter
                          version must match the recorded ones, genesis values it
                          lacks are added, differing ones are an error
          --jobs N        slots (default: from available memory and cores); a log larger
                          than total size / slots gets its share of the slots
          --keep-temp     keep the temporary directory when a conversion fails
          --zstd-level N  zstd compression level (default: $zstd_default)

  restore PQDIR PROCESS -o FILE [--verify]
        Reconstruct a process's log. --verify checks the sha256 recorded at
        conversion. Refuses to write over the converted log itself while it
        exists (restoring it after deletion is fine).
  restore PQDIR PROCESS=FILE.. [--jobs N]
        The same for several logs, scheduled like convert; each FILE is written
        through FILE.restoring and renamed only once verified; an existing FILE
        is skipped. Exit status 1 if any log failed.

  verify PQDIR [PROCESS..] [--jobs N]
        Rebuild each log (default: all) in memory and compare its sha256 with the
        one recorded at conversion; nothing is written. On stdout one line per
        log, "PROCESS<TAB>ok" or "PROCESS<TAB>failed"; exit status 1 if any failed.
        --jobs N as for convert.

  head PQDIR PROCESS [-n N]
  tail PQDIR PROCESS [-n N]
        The first / last N lines (default 20) of the process's log on stdout,
        byte for byte as in the original, text lines included.

  excerpt PQDIR (--at TIMESTAMP | --ns NAMESPACE [--where SQL]) [--before SECS] [--after SECS]
          [--process P].. -o OUTDIR
        Original log lines in a time window around a timestamp, or around the
        first event of NAMESPACE (optionally matching the SQL condition on its
        columns, e.g. "data->>'\$.slot' = '991'"), one file per process in OUTDIR.
        Defaults: --before 5 --after 5, all processes.

  lines PQDIR PROCESS [--ns-file FILE]
        The process's JSON lines on stdout, byte for byte as in the original log
        and in its order; with --ns-file only those of the namespaces listed in
        FILE (one per line). For locli prepare-db-from-lines.

  host-summary PQDIR PROCESS
        JSON on stdout: line counts per namespace ("tracefreqs"), the number of
        JSON lines ("lines"), and the timestamps of the first and the last JSON
        line in log order ("firstAt", "lastAt"). For locli prepare-db-from-lines.

  query PQDIR [--ui] [--load PATH].. [DUCKDB-ARGS..]
        Interactive DuckDB session with views and macros for the logs loaded.
          --ui         also start the DuckDB UI on the same session and open it in
                       a new browser tab (installs the ui extension on first use,
                       which needs network access)
          --load PATH  also read PATH into the session, after the package views:
                       a SQL file, or every *.sql directly in a directory, in byte
                       order of the file names; repeatable, read in the order given
                       (e.g. user_sql/views/, user_sql/queries/locli/)

  run PQDIR [--load PATH].. [--csv] (FILE.sql | NAME)
        Run a SQL file in such a session; NAME (no "/", no ".sql") is a prepared
        query of the package, sql/queries/*/NAME.sql (e.g. heap_bumps).
          Tables show every row (no display limit); --csv gives CSV instead.
          --csv        results as CSV instead of tables

  check PQDIR [NAME..]
        Run the package checks (sql/checks/; default: all, NAME with or without
        the chk_ prefix) in such a session. On stdout, tab-separated, one line per
        violation: violation, check, process, ts, observed, expected; and one
        line "none", check, -, -, none, - per check without violations. Exit
        status 0 whatever the checks find (judging them is the caller's part).

  remote SSH-HOST [--memory SIZE] [--threads N] [--spill-limit SIZE] COMMAND PQDIR ARGS..
        Run COMMAND (query, run, check, verify, head, tail, lines, host-summary)
        on SSH-HOST, over PQDIR there (absolute, or relative to the home
        directory); output and exit status come back as from a local run. The
        remote runs this package (shipped on first use of a version, into
        ~/.cache/bench-parquet/) with its tools from the nixpkgs revision of the
        enclosing flake.lock, evaluated locally for the remote's system and
        fetched there with nix-store -r: SSH-HOST needs nix and a substituter
        with them (cache.nixos.org), no checkout and no trusted user. Local SQL
        files given to run or --load (and lines --ns-file) are shipped per call.
        query is interactive when stdin is a terminal and there is no -c (no --ui).
          --memory SIZE       DuckDB memory limit per session (default: 4GB)
          --threads N         DuckDB threads per session (default: 4)
          --spill-limit SIZE  most a session may spill to disk (default: 10GB)

Environment: DUCKDB (default: duckdb from PATH). BENCH_PARQUET_MEMORY,
BENCH_PARQUET_THREADS, BENCH_PARQUET_SPILL, BENCH_PARQUET_SPILL_LIMIT: if set,
a session's memory_limit, threads, temp_directory, max_temp_directory_size.
EOF
}

msg()  { echo "bench-parquet: $*" >&2; }
die()  { msg "$*"; exit 1; }
# A SQL string literal.
sqlq() { local s=${1//\'/\'\'}; printf "'%s'" "$s"; }
# A SQL quoted identifier.
sqli() { local s=${1//\"/\"\"}; printf '"%s"' "$s"; }

# A converted directory (PQDIR): <process>.parquet files and meta/.
check_pqdir() {
    local pq=$1
    test -d "$pq" || die "not a directory: $pq"
    test -f "$pq"/meta/files.parquet ||
        die "no meta/files.parquet in $pq (not written by bench-parquet convert)"
    local v
    v=$("$DUCKDB" -init /dev/null -noheader -list -c "
        SELECT raw_schema_version FROM read_parquet($(sqlq "$pq/meta/run.parquet"));")
    test "$v" = "$raw_schema_version" ||
        die "$pq has raw schema version $v; this bench-parquet reads version $raw_schema_version (convert again)"
}

##############################################################################
# The commands, by area. Sourced: they share the helpers and variables above.
lib_dir=$self_dir/lib
# shellcheck source=lib/slots.sh
source "$lib_dir/slots.sh"
# shellcheck source=lib/convert.sh
source "$lib_dir/convert.sh"
# shellcheck source=lib/session.sh
source "$lib_dir/session.sh"
# shellcheck source=lib/restore.sh
source "$lib_dir/restore.sh"
# shellcheck source=lib/logs.sh
source "$lib_dir/logs.sh"
# shellcheck source=lib/remote.sh
source "$lib_dir/remote.sh"

##############################################################################

cmd=${1:-}; test $# -eq 0 || shift
case "$cmd" in
    convert )     convert_cmd "$@";;
    restore )     restore_cmd "$@";;
    verify )      verify_cmd "$@";;
    excerpt )     excerpt_cmd "$@";;
    lines )       lines_cmd "$@";;
    host-summary ) host_summary_cmd "$@";;
    head | tail ) head_tail_cmd "$cmd" "$@";;
    query )       query_cmd "$@";;
    run )         run_cmd "$@";;
    check )       check_cmd "$@";;
    remote )      remote_cmd "$@";;
    remote-exec ) remote_exec "$@";;
    help | -h | --help | "" ) usage;;
    * )           usage >&2; exit 1;;
esac
